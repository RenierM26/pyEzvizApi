@@ -0,0 +1,50 @@
+package streams
+
+import (
+	"errors"
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"testing"
+)
+
+type oneShotTestProducer struct {
+	core.Connection
+	policy     bool
+	startError error
+	stops      int
+}
+
+func (c *oneShotTestProducer) Start() error      { return c.startError }
+func (c *oneShotTestProducer) Stop() error       { c.stops++; return nil }
+func (c *oneShotTestProducer) NoReconnect() bool { return c.policy }
+
+func TestOneShotFailureKeepsTerminalAcrossStop(t *testing.T) {
+	c := &oneShotTestProducer{policy: true, startError: errors.New("source failed")}
+	p := &Producer{conn: c, state: stateStart, workerID: 1}
+	p.worker(c, 1)
+	if !p.sourceEnded {
