--- /dev/null
+++ b/tests/test_websocket_closed_heartbeat.py
@@ -0,0 +1,27 @@
+"""A closed websocket must not recreate heartbeat timers on late parser data."""
+import asyncio
+
+import pytest
+
+from aiohttp.web_ws import WebSocketResponse
+
+
+@pytest.mark.parametrize("closed", [False, True])
+@pytest.mark.parametrize("entry", ["_on_data_received", "_reset_heartbeat"])
+async def test_heartbeat_callback_after_close_does_not_rearm(closed, entry):
+    ws = WebSocketResponse(heartbeat=10)
+    ws._loop = asyncio.get_running_loop()
+    if closed:
+        ws._set_closed()
+    try:
+        getattr(ws, entry)()
+        await asyncio.sleep(0)
+        if closed:
+            assert ws._heartbeat_cb is None
+            assert ws._heartbeat_reset_handle is None
+            assert not ws._need_heartbeat_reset
+        else:
+            assert ws._heartbeat_cb is not None
+            assert not ws._heartbeat_cb.cancelled()
+    finally:
+        ws._cancel_heartbeat()
