+++ b/pkg/mpegts/end_order_test.go
@@ -0,0 +1,78 @@
+package mpegts
+
+import (
+	"bytes"
+	"io"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+)
+
+// A gated audio sender cannot finish before the video sender is told to end.
+// Exercise Start's real completion/error path with audio registered first.
+func TestSourceEpochTerminalTrackNotificationsJoinWithoutOrderingDeadlock(t *testing.T) {
+	for _, failed := range []bool{false, true} {
+		t.Run(map[bool]string{false: "finite", true: "source_error"}[failed], func(t *testing.T) {
+			videoEnded := make(chan struct{})
+			audioRelease := make(chan struct{})
+			var endOnce sync.Once
+			release := func() { endOnce.Do(func() { close(videoEnded) }) }
+			defer release()
+			audio := core.NewReceiver(&core.Media{Kind: core.KindAudio}, &core.Codec{Name: core.CodecAAC})
+			video := core.NewReceiver(&core.Media{Kind: core.KindVideo}, &core.Codec{Name: core.CodecH264})
+			(&core.Node{OnEnd: func(error) { <-videoEnded; <-audioRelease }}).WithParent(&audio.Node)
+			(&core.Node{OnEnd: func(error) { release() }}).WithParent(&video.Node)
+			var input io.Reader = bytes.NewReader(nil)
+			expected := core.ErrFiniteSource
+			if failed {
+				input = failedReader{io.ErrClosedPipe}
+				expected = io.ErrClosedPipe
+			}
+			origin := uint64(0)
+			p := &Producer{Connection: core.Connection{Receivers: []*core.Receiver{audio, video}}, rd: core.NewReadBuffer(input), Finite: true, ClockOrigin90k: &origin}
+			done := make(chan error, 1)
+			go func() { done <- p.Start() }()
+			select {
+			case <-videoEnded:
+			case <-time.After(200 * time.Millisecond):
+				release()
+				close(audioRelease)
+				<-done
+				t.Fatal("audio-first terminal notification blocked video completion")
+			}
+			select {
+			case <-done:
+				close(audioRelease)
+				t.Fatal("Start returned before gated audio joined")
+			default:
+			}
+			close(audioRelease)
+			select {
+			case err := <-done:
+				if err != expected {
+					t.Fatalf("terminal outcome changed: %v", err)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("terminal notifications did not join")
+			}
+		})
+	}
+}
+
+func TestSourceEpochUndeclaredTerminalOrderUnchanged(t *testing.T) {
+	var order []int
+	producer := &Producer{rd: core.NewReadBuffer(bytes.NewReader(nil)), Finite: true}
+	for i := 0; i < 3; i++ {
+		receiver := core.NewReceiver(&core.Media{Kind: core.KindAudio}, &core.Codec{Name: core.CodecAAC})
+		(&core.Node{OnEnd: func(error) { order = append(order, i) }}).WithParent(&receiver.Node)
+		producer.Receivers = append(producer.Receivers, receiver)
+	}
+	if err := producer.Start(); err != core.ErrFiniteSource {
+		t.Fatal(err)
+	}
+	if len(order) != 3 || order[0] != 0 || order[1] != 1 || order[2] != 2 {
+		t.Fatal("undeclared producer completion order changed", order)
+	}
+}
