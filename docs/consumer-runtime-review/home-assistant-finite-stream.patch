+"""Finite source generation, publication and terminal HLS regression controls."""
+
+# White-box tests deliberately control thread/publication boundaries.
+
+import asyncio
+from collections.abc import Callable
+from fractions import Fraction
+import threading
+from typing import cast
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+
+from homeassistant.components.camera import DynamicStreamSettings
+from homeassistant.components.stream import Stream
+from homeassistant.components.stream.core import Part, Segment, StreamSettings
+from homeassistant.components.stream.finite import (
+    FiniteSourceCounts,
+    FiniteSourceSession,
+    FiniteSourceState as State,
+)
+from homeassistant.components.stream.hls import HlsMasterPlaylistView, HlsPlaylistView
+from homeassistant.components.stream.worker import StreamMuxer, StreamWorkerError
+from homeassistant.core import HomeAssistant
+from homeassistant.exceptions import HomeAssistantError
+from homeassistant.util import dt as dt_util
+
+
+@pytest.fixture
+def stream(hass: HomeAssistant) -> Stream:
+    """Stream."""
+    return Stream(
+        hass,
+        "unused://retained",
+        {},
+        StreamSettings(True, 5.9, 1, 3, 2),
+        DynamicStreamSettings(),
+    )
+
+
+def active() -> FiniteSourceSession:
+    """Active."""
+    s = FiniteSourceSession()
+    assert s.begin()
+    return s
+
+
+def confirmed() -> FiniteSourceSession:
+    """Return an active session with authoritative completion counts."""
+    s = active()
+    assert s.confirm(FiniteSourceCounts(1, 0))
+    return s
+
+
+def finalizing() -> FiniteSourceSession:
+    """Return a session that received matching owner confirmation and EOF."""
+    s = confirmed()
+    assert s.receive_eof(threading.Event(), timeout=0)
+    return s
+
+
+def completed() -> FiniteSourceSession:
+    """Return a session that published its terminal media."""
+    s = finalizing()
+    assert s.publish(lambda: None)
+    return s
+
+
+def test_once_and_idempotent_confirmation() -> None:
+    """Once and idempotent confirmation."""
+    s = active()
+    assert not s.begin()
+    assert s.confirm(FiniteSourceCounts(1, 0)) and s.confirm(FiniteSourceCounts(1, 0))
+    assert s.state == State.ACTIVE
+    assert s.receive_eof(threading.Event(), 0)
+    count = []
+    assert s.publish(lambda: count.append(1))
+    assert not s.publish(lambda: count.append(2))
+    assert s.confirm(FiniteSourceCounts(1, 0))
+    assert count == [1] and s.state == State.COMPLETED
+    assert not s.begin()
+
+
+def test_confirmation_before_start_refused() -> None:
+    """Confirmation before start refused."""
+    s = FiniteSourceSession()
+    assert not s.confirm(FiniteSourceCounts(1, 0))
+    assert s.state == State.READY
+
+
+def test_unconfirmed_eof_fails_without_retry() -> None:
+    """Unconfirmed eof fails without retry."""
+    s = active()
+    assert not s.receive_eof(threading.Event(), 0)
+    assert s.state == State.FAILED
+    assert not s.confirm(FiniteSourceCounts(1, 0)) and not s.begin()
+    s.cancel()
+    assert s.state == State.FAILED
+
+
+async def test_confirmation_can_arrive_after_receiving_eof() -> None:
+    """Confirmation can arrive after receiving eof."""
+    s = active()
+    task = asyncio.create_task(asyncio.to_thread(s.receive_eof, threading.Event(), 1))
+    async with asyncio.timeout(1):
+        while s.state != State.WAITING:
+            await asyncio.sleep(0.001)
+    assert s.confirm(FiniteSourceCounts(1, 0))
+    assert await task
+    assert s.state == State.FINALIZING
+
+
+async def test_stop_wakes_unconfirmed_eof() -> None:
+    """Stop wakes unconfirmed eof."""
+    s = active()
+    quit_event = threading.Event()
+    task = asyncio.create_task(asyncio.to_thread(s.receive_eof, quit_event, 1))
+    async with asyncio.timeout(1):
+        while s.state != State.WAITING:
+            await asyncio.sleep(0.001)
+    s.cancel()
+    assert not await task
+    assert s.state == State.CANCELLED
+
+
+@pytest.mark.parametrize(
+    "source_state",
+    [FiniteSourceSession, active, confirmed, finalizing, completed],
+    ids=["ready", "active", "confirmed", "finalizing", "completed"],
+)
+def test_cancel_revokes_each_boundary(
+    source_state: Callable[[], FiniteSourceSession],
+) -> None:
+    """Revocation invalidates publication from every admitted state."""
+    s = source_state()
+    s.cancel()
+    assert not s.confirm(FiniteSourceCounts(1, 0))
+    assert not s.publish(lambda: pytest.fail("stale publication"))
+    assert not s.begin() and s.state == State.CANCELLED
+
+
+def test_quit_race_prevents_finalization() -> None:
+    """Quit race prevents finalization."""
+    s = active()
+    s.confirm(FiniteSourceCounts(1, 0))
+    q = threading.Event()
+    q.set()
+    assert not s.receive_eof(q, 0)
+    assert s.state == State.CANCELLED
+
+
+def test_publication_error_is_not_completion() -> None:
+    """Publication error is not completion."""
+    s = finalizing()
+
+    def fail() -> None:
+        """Fail."""
+        raise OSError("publication failed")
+
+    with pytest.raises(OSError):
+        s.publish(fail)
+    assert s.state == State.FAILED
+    assert not s.confirm(FiniteSourceCounts(1, 0)) and not s.begin()
+
