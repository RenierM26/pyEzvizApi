+"""Version negotiation and pre-await finite publication revocation."""
+
+# White-box boundary controls deliberately inspect worker state.
+from threading import Event
+
+from homeassistant.components.camera import DynamicStreamSettings
+from homeassistant.components.stream import FINITE_SOURCE_COMPLETION_CONTRACT, Stream
+from homeassistant.components.stream.core import StreamSettings
+from homeassistant.components.stream.finite import (
+    FiniteSourceCounts,
+    FiniteSourceHandle,
+)
+from homeassistant.core import HomeAssistant
+
+
+async def test_declared_completion_contract() -> None:
+    """Declared completion contract."""
+    assert FINITE_SOURCE_COMPLETION_CONTRACT == "source-access-units-v1"
+
+
+async def test_foreign_revoke_cannot_cancel_current_worker(hass: HomeAssistant) -> None:
+    """Foreign revoke cannot cancel current worker."""
+    stream = Stream(
+        hass, "unused", {}, StreamSettings(True, 5.9, 1, 3, 2), DynamicStreamSettings()
+    )
+    stream.async_prepare_finite_source()
+    assert not stream.async_cancel_finite_source(FiniteSourceHandle())
+    assert stream.finite_source_state == "ready" and not stream._thread_quit.is_set()
+    await stream.stop()
+
+
+async def test_revocation_before_await_prevents_pending_publication(
+    hass: HomeAssistant,
+) -> None:
+    """Revocation before await prevents pending publication."""
+    stream = Stream(
+        hass, "unused", {}, StreamSettings(True, 5.9, 1, 3, 2), DynamicStreamSettings()
+    )
+    handle = stream.async_prepare_finite_source()
+    controller = stream._finite_source
+    assert controller.begin() and stream.async_confirm_finite_source(
+        handle, FiniteSourceCounts(1, 0)
+    )
+    assert controller.receive_eof(Event(), 0)
+    assert stream.async_cancel_finite_source(handle)
+    assert stream.finite_source_state == "cancelled" and stream._thread_quit.is_set()
+    published = []
+    stream._async_publish_finite(controller, lambda: published.append(1))
+    assert not published
+    await stream.stop()
