+class FiniteSourceSession:
+    """Opaque stream-specific generation and thread-safe one-shot state.
+
+    Integrations confirm through Stream only after their own authoritative source
+    and subscription completion checks. This object does not validate media or
+    proprietary receipts. Its state never authorizes another ingest attempt.
+    """
+
+    def __init__(self) -> None:
+        """Initialize an unstarted finite generation."""
+        self.handle = FiniteSourceHandle()
+        self._lock = Lock()
