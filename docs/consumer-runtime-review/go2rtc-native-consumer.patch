+	s := sourceClockSender{mapping: m, rate: 90000}
+	s.report(&rtp.Packet{Header: rtp.Header{Timestamp: 1}})
+	if !s.disabled || !m.failed.Load() {
+		t.Fatal("ambiguous epoch guessed")
+	}
+}
