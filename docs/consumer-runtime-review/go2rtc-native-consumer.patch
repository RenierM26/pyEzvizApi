@@ -0,0 +1,32 @@
+package core
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"sync"
+)
+
+// NativeReference is an in-process capability, not an upstream clock assertion.
+type NativeReference struct {
+	Clock  *SourceClock
+	Policy *SourcePolicy
+}
+
+var nativeReferences sync.Map
+
+func RegisterNativeReference(ref *NativeReference) string {
+	b := make([]byte, 32)
+	if _, err := rand.Read(b); err != nil {
+		panic(err)
+	}
+	token := hex.EncodeToString(b)
+	nativeReferences.Store(token, ref)
+	return token
+}
+func LookupNativeReference(token string) *NativeReference {
+	if value, ok := nativeReferences.Load(token); ok {
+		return value.(*NativeReference)
+	}
+	return nil
+}
+func RemoveNativeReference(token string) { nativeReferences.Delete(token) }
