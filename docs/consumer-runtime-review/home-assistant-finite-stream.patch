+
+async def test_failed_thread_start_cannot_retry(stream: Stream) -> None:
+    """Failed thread start cannot retry."""
+    stream.async_prepare_finite_source()
+    with (
+        patch("threading.Thread.start", side_effect=RuntimeError("cannot start")),
