+
+async def test_default_stream_retry_behavior_untouched(stream: Stream) -> None:
+    """Default stream retry behavior untouched."""
+    with patch("threading.Thread") as factory:
+        factory.return_value.is_alive.return_value = False
+        await stream.start()
+        await stream.start()
+        assert factory.return_value.start.call_count == 2
