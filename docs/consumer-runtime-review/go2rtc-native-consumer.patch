+
+func TestAggregationDepayPreservesOriginalNALsAndClock(t *testing.T) {
+	aud := []byte{35 << 1, 1, 0x50}
+	slice := append([]byte{1 << 1, 1}, bytes.Repeat([]byte{0x81}, 1200)...)
+	input := aggregate(aud, slice)
+	var output []*rtp.Packet
+	depay := RTPDepay(&core.Codec{}, func(p *rtp.Packet) {
+		clone := *p
+		clone.Payload = bytes.Clone(p.Payload)
+		output = append(output, &clone)
+	})
+	depay(&rtp.Packet{Header: rtp.Header{Version: 2, Marker: true, Timestamp: 0xfffffff0, SequenceNumber: 65535}, Payload: input})
+	require.Len(t, output, 1)
+	require.Equal(t, h264.JoinNALU(aud, slice), output[0].Payload)
+	require.Equal(t, uint32(0xfffffff0), output[0].Timestamp)
+	require.Equal(t, uint8(h264.RTPPacketVersionAVC), output[0].Version)
+}
+
+func TestAggregationRoundTripBetweenDifferentMTUs(t *testing.T) {
+	aud := []byte{35 << 1, 1, 0x50}
+	slice := append([]byte{1 << 1, 1}, bytes.Repeat([]byte{0x81}, 1200)...)
+	var wire []*rtp.Packet
+	small := RTPPay(1200, func(p *rtp.Packet) { wire = append(wire, p) })
+	depay := RTPDepay(&core.Codec{}, small)
+	large := RTPPay(1472, depay)
+	large(&rtp.Packet{Header: rtp.Header{Version: h264.RTPPacketVersionAVC, Timestamp: 987654321}, Payload: h264.JoinNALU(aud, slice)})
+	var decoded [][]byte
+	var pending []byte
+	for _, p := range wire {
+		require.LessOrEqual(t, len(p.Payload), 1200-12)
+		require.Equal(t, uint32(987654321), p.Timestamp)
+		kind := (p.Payload[0] >> 1) & 63
+		if kind == 49 {
+			fu := p.Payload[2]
+			require.Less(t, fu&63, byte(48), "an AP or FU cannot itself be fragmented")
+			if fu&128 != 0 {
+				require.Nil(t, pending)
+				pending = []byte{(p.Payload[0] & 0x81) | ((fu & 63) << 1), p.Payload[1]}
+			}
+			require.NotNil(t, pending)
+			pending = append(pending, p.Payload[3:]...)
+			if fu&64 != 0 {
+				decoded = append(decoded, pending)
+				pending = nil
+			}
+		} else if kind == 48 {
+			for data := p.Payload[2:]; len(data) > 0; {
+				n := int(binary.BigEndian.Uint16(data))
+				require.GreaterOrEqual(t, len(data), n+2)
+				decoded = append(decoded, data[2:n+2])
+				data = data[n+2:]
+			}
+		} else {
+			decoded = append(decoded, p.Payload)
+		}
+	}
+	require.Nil(t, pending)
+	require.Equal(t, [][]byte{aud, slice}, decoded)
+	require.True(t, wire[len(wire)-1].Marker)
+}
+
+func TestMalformedAggregationDropsWholeAUAndRecovers(t *testing.T) {
+	good := aggregate([]byte{70, 1, 0x50}, []byte{2, 1, 0x81})
+	invalid := map[string][]byte{
+		"empty": {96, 1}, "one": aggregate([]byte{2, 1, 1}), "truncated-length": {96, 1, 0},
+		"zero-length": {96, 1, 0, 0}, "short-header": {96, 1, 0, 1, 2}, "truncated-NAL": {96, 1, 0, 5, 2, 1},
+		"nested-AP": aggregate([]byte{96, 1, 1}, []byte{2, 1, 1}), "nested-FU": aggregate([]byte{98, 1, 1}, []byte{2, 1, 1}),
+		"PACI": aggregate([]byte{100, 1, 1}, []byte{2, 1, 1}), "forbidden": aggregate([]byte{130, 1, 1}, []byte{2, 1, 1}),
+		"zero-tid": aggregate([]byte{2, 0, 1}, []byte{2, 1, 1}), "valid-then-truncated": append(bytes.Clone(good), 0, 4, 2),
+	}
+	for name, payload := range invalid {
+		t.Run(name, func(t *testing.T) {
+			var output [][]byte
+			depay := RTPDepay(&core.Codec{}, func(p *rtp.Packet) { output = append(output, bytes.Clone(p.Payload)) })
+			depay(&rtp.Packet{Header: rtp.Header{Version: 2, SequenceNumber: 1}, Payload: payload})
+			depay(&rtp.Packet{Header: rtp.Header{Version: 2, SequenceNumber: 2, Marker: true}, Payload: []byte{2, 1, 0x81}})
+			require.Empty(t, output)
+			depay(&rtp.Packet{Header: rtp.Header{Version: 2, SequenceNumber: 3, Marker: true}, Payload: good})
+			require.Equal(t, [][]byte{h264.JoinNALU([]byte{70, 1, 0x50}, []byte{2, 1, 0x81})}, output)
+		})
+	}
+}
+
+func TestAggregationWithNegotiatedDONLIsNotMisparsed(t *testing.T) {
+	output := 0
+	depay := RTPDepay(&core.Codec{FmtpLine: "sprop-max-don-diff=1"}, func(p *rtp.Packet) { output++ })
+	depay(&rtp.Packet{Header: rtp.Header{Version: 2, Marker: true}, Payload: aggregate([]byte{70, 1, 0x50}, []byte{2, 1, 0x81})})
+	require.Zero(t, output)
+}
