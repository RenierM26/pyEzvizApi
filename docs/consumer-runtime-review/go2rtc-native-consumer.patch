+func TestSourceClockH264ParserBoundaryBeforeAudio(t *testing.T) {
+	left, right := net.Pipe()
+	defer left.Close()
+	defer right.Close()
+	c := NewServer(left)
+	c.sourceClock = &sourceClockMapping{}
+	c.mode = core.ModePassiveConsumer
+	c.sourceVideoReady = make(chan struct{})
+	c.sourceClosed = make(chan struct{})
+	vc := &core.Codec{Name: core.CodecH264, ClockRate: 90000, PayloadType: core.PayloadTypeRAW}
+	ac := &core.Codec{Name: core.CodecAAC, ClockRate: 16000, PayloadType: core.PayloadTypeRAW}
+	vm := &core.Media{Kind: core.KindVideo}
+	am := &core.Media{Kind: core.KindAudio}
+	video := core.NewReceiver(vm, vc)
+	audio := core.NewReceiver(am, ac)
+	if err := c.AddTrack(vm, vc, video); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.AddTrack(am, ac, audio); err != nil {
+		t.Fatal(err)
+	}
+	type event struct {
+		channel byte
+		ts      uint32
+		marker  bool
+	}
+	events := make(chan event, 32)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		for {
+			h := make([]byte, 4)
+			if _, e := io.ReadFull(right, h); e != nil {
+				return
+			}
+			b := make([]byte, int(h[2])<<8|int(h[3]))
+			if _, e := io.ReadFull(right, b); e != nil {
+				return
+			}
+			if h[1]%2 == 0 {
+				p := &rtp.Packet{}
+				if p.Unmarshal(b) == nil {
+					events <- event{h[1], p.Timestamp, p.Marker}
+				}
+			}
+		}
+	}()
+	packet := func(ts uint32, nal byte) *rtp.Packet {
+		return &rtp.Packet{Header: rtp.Header{Timestamp: ts}, Payload: []byte{0, 0, 0, 2, nal, 0x80}}
+	}
+	video.WriteRTP(packet(90000, 0x65))
+	audio.WriteRTP(&rtp.Packet{Header: rtp.Header{Timestamp: 16000}, Payload: []byte{1, 2, 3}})
+	select {
+	case e := <-events:
+		if e.channel != 0 || !e.marker {
+			t.Fatal("opening video absent", e)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("opening video blocked")
+	}
+	select {
+	case e := <-events:
+		t.Fatal("audio overtook parser boundary", e)
+	case <-time.After(20 * time.Millisecond):
+	}
+	video.WriteRTP(packet(99000, 0x41))
+	select {
+	case e := <-events:
+		if e.channel != 0 || e.ts != 99000 || !e.marker {
+			t.Fatal("original next video boundary absent", e)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("next video blocked")
+	}
+	select {
+	case e := <-events:
+		if e.channel != 2 {
+			t.Fatal("audio not released", e)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("audio held after parser boundary")
+	}
+	video.End(nil)
+	audio.End(nil)
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("finite writers not closed")
+	}
+}
