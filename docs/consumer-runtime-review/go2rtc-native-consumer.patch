new file mode 100644
index 0000000..d33dfc5
--- /dev/null
+++ b/pkg/mpegts/source_epoch_test.go
@@ -0,0 +1,56 @@
+package mpegts
+
+import (
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/pion/rtp"
+	"testing"
+)
+
+func TestSourceEpochFull33BitRead(t *testing.T) {
+	for _, ts := range []uint64{0, 1, (uint64(1) << 32) + 12345, (uint64(1) << 33) - 1} {
+		d := NewDemuxer()
+		d.buf[0] = byte(0x21 | ((ts>>30)&7)<<1)
+		d.buf[1] = byte(ts >> 22)
+		d.buf[2] = byte((ts>>15)<<1 | 1)
+		d.buf[3] = byte(ts >> 7)
+		d.buf[4] = byte(ts<<1 | 1)
+		if got := d.readTime(); got != ts {
+			t.Fatal("source clock truncated", ts, got)
+		}
+	}
+}
+func TestSourceEpoch33WrapAndRejectReset(t *testing.T) {
+	s := &sourceEpoch{}
+	origin := (uint64(1) << 33) - 100
+	if x, e := s.lift(origin, origin); e != nil || x != origin {
+		t.Fatal(x, e)
+	}
+	if x, e := s.lift(100, origin); e != nil || x != (uint64(1)<<33)+100 {
+		t.Fatal("wrap", x, e)
+	}
+	if _, e := s.lift(99, origin); e == nil {
+		t.Fatal("reset repaired")
+	}
+	late := &sourceEpoch{}
+	x, e := late.lift(100, (uint64(3)<<33)+100)
+	if e != nil || x != (uint64(3)<<33)+100 {
+		t.Fatal("initial epoch guessed", x, e)
+	}
+}
+func TestSourceEpochRateConversionUsesFullTime(t *testing.T) {
+	source := (uint64(1) << 32) + 90000
+	p := &Producer{}
+	media := &core.Media{Kind: core.KindAudio}
+	codec := &core.Codec{Name: core.CodecAAC, ClockRate: 16000}
+	receiver, _ := p.GetTrack(media, codec)
+	var timestamp uint32
+	child := &core.Node{Input: func(pkt *rtp.Packet) { timestamp = pkt.Timestamp }}
+	child.WithParent(&receiver.Node)
+	if e := p.deliver(&rtp.Packet{Header: rtp.Header{PayloadType: StreamTypeAAC}}, source); e != nil {
+		t.Fatal(e)
+	}
+	expected := uint32((source/90000)*16000 + (source%90000)*16000/90000)
+	if timestamp != expected {
+		t.Fatal("audio epoch lost", timestamp, expected)
+	}
+}
