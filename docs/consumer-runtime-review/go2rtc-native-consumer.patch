+func TestOneShotRTSPDeclarationRoundTrip(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		t.Run(map[bool]string{false: "default", true: "declared"}[enabled], func(t *testing.T) {
+			a, b := net.Pipe()
+			defer a.Close()
+			defer b.Close()
+			server := NewServer(b)
+			server.Listen(func(msg any) {
+				if msg != MethodDescribe {
+					return
+				}
+				codec := &core.Codec{Name: core.CodecAAC, ClockRate: 16000, Channels: 1, PayloadType: core.PayloadTypeRAW}
+				media := &core.Media{Kind: core.KindAudio, Direction: core.DirectionRecvonly, Codecs: []*core.Codec{codec}}
+				track := core.NewReceiver(media, codec)
+				if enabled {
+					track.SourcePolicy = &core.SourcePolicy{OneShot: true}
+				}
+				if err := server.AddTrack(media, codec, track); err != nil {
+					t.Error(err)
+				}
+			})
+			done := make(chan struct{})
+			go func() { _ = server.Accept(); close(done) }()
+			client := NewClient("rtsp://127.0.0.1/policy")
+			client.URL, _ = url.Parse(client.uri)
+			client.conn = a
+			client.reader = bufio.NewReader(a)
+			client.auth = tcp.NewAuth(nil)
+			if err := client.Describe(); err != nil {
+				t.Fatal(err)
+			}
+			if client.NoReconnect() != enabled {
+				t.Fatal("RTSP policy lost or default changed")
+			}
+			a.Close()
+			b.Close()
+			select {
+			case <-done:
+			case <-time.After(time.Second):
+				t.Fatal("server not joined")
+			}
+			for _, sender := range server.Senders {
+				sender.Close()
+				sender.Wait()
+			}
+		})
+	}
+}
