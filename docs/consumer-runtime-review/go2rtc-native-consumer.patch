--- /dev/null
+++ b/pkg/webrtc/rtx_sequence_test.go
@@ -0,0 +1,83 @@
+package webrtc
+
+import (
+	"bytes"
+	"errors"
+	"sync"
+	"testing"
+
+	"github.com/pion/interceptor"
+	"github.com/pion/rtp"
+)
+
+func TestRTXSequenceImmutableCacheAndWrap(t *testing.T) {
+	header := &rtp.Header{Version: 2, SSRC: 9, SequenceNumber: 17, Timestamp: 123, Marker: true}
+	payload := []byte{0, 7, 5, 6}
+	original := header.Clone()
+	var previous uint16
+	count := 0
+	writer := interceptor.RTPWriterFunc(func(actual *rtp.Header, body []byte, _ interceptor.Attributes) (int, error) {
+		if count > 0 && actual.SequenceNumber != previous+1 {
+			t.Fatalf("sequence=%d previous=%d", actual.SequenceNumber, previous)
+		}
+		previous = actual.SequenceNumber
+		count++
+		if actual.Timestamp != 123 || actual.SSRC != 9 || !actual.Marker || !bytes.Equal(body, payload) {
+			t.Fatal("RTX media/clock changed")
+		}
+		return len(body), nil
+	})
+	output := (&rtxSequenceInterceptor{}).BindLocalStream(&interceptor.StreamInfo{SSRC: 7, SSRCRetransmission: 9}, writer)
+	for range 65537 {
+		if _, err := output.Write(header, payload, nil); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if count != 65537 || header.SequenceNumber != original.SequenceNumber || header.Timestamp != original.Timestamp || header.SSRC != original.SSRC {
+		t.Fatal("cached header modified")
+	}
+}
+
+func TestRTXSequenceConcurrentResends(t *testing.T) {
+	header := &rtp.Header{Version: 2, SSRC: 9, SequenceNumber: 17}
+	sequences := map[uint16]bool{}
+	writer := interceptor.RTPWriterFunc(func(actual *rtp.Header, _ []byte, _ interceptor.Attributes) (int, error) {
+		if sequences[actual.SequenceNumber] {
+			t.Error("transport sequence reused")
+		}
+		sequences[actual.SequenceNumber] = true
+		return 1, nil
+	})
+	output := (&rtxSequenceInterceptor{}).BindLocalStream(&interceptor.StreamInfo{SSRC: 7, SSRCRetransmission: 9}, writer)
+	var workers sync.WaitGroup
+	for range 64 {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			if _, err := output.Write(header, []byte{1}, nil); err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	workers.Wait()
+	if len(sequences) != 64 || header.SequenceNumber != 17 {
+		t.Fatal("resend count/cache identity changed")
+	}
+}
+
+func TestRTXSequencePassThroughAndErrors(t *testing.T) {
+	for _, rtxSSRC := range []uint32{0, 9} {
+		expected := errors.New("bounded writer failure")
+		primary := &rtp.Header{Version: 2, SSRC: 7, SequenceNumber: 55}
+		writer := interceptor.RTPWriterFunc(func(actual *rtp.Header, _ []byte, _ interceptor.Attributes) (int, error) {
+			if actual != primary || actual.SequenceNumber != 55 {
+				t.Fatal("primary/legacy header replaced")
+			}
+			return 0, expected
+		})
+		output := (&rtxSequenceInterceptor{}).BindLocalStream(&interceptor.StreamInfo{SSRC: 7, SSRCRetransmission: rtxSSRC}, writer)
+		if _, err := output.Write(primary, nil, nil); !errors.Is(err, expected) {
+			t.Fatalf("writer error changed: %v", err)
+		}
+	}
+}
