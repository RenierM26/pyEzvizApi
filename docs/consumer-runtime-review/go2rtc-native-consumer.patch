@@ -0,0 +1,77 @@
+package core
+
+import (
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/pion/rtp"
+	"github.com/stretchr/testify/require"
+)
+
+func audioSender() *Sender {
+	return NewSender(&Media{Kind: KindAudio}, &Codec{Name: CodecOpus, ClockRate: 48000})
+}
+func TestBoundedInputRetainsExistingCapacityAndAllowsStart(t *testing.T) {
+	s := audioSender()
+	var mu sync.Mutex
+	var stamps []uint32
+	s.Handler = func(p *Packet) { mu.Lock(); stamps = append(stamps, p.Timestamp); mu.Unlock() }
+	for i := range 128 {
+		s.Input(&rtp.Packet{Header: rtp.Header{Timestamp: uint32(i)}})
+	}
+	finished := make(chan struct{})
+	go func() {
+		s.InputWithTimeout(&rtp.Packet{Header: rtp.Header{Timestamp: 128}}, time.Second)
+		close(finished)
+	}()
+	// Start must acquire its mutex while bounded input is waiting for capacity.
+	s.Start()
+	select {
+	case <-finished:
+	case <-time.After(time.Second):
+		t.Fatal("bounded input prevented Start")
+	}
+	s.Close()
+	s.Wait()
+	mu.Lock()
+	defer mu.Unlock()
+	require.Len(t, stamps, 129)
+	for i, stamp := range stamps {
+		require.Equal(t, uint32(i), stamp)
+	}
+	require.Equal(t, 0, s.Drops)
+	require.Equal(t, 129, s.Packets)
+}
+func TestBoundedInputTimeoutFailsInsteadOfGrowingQueue(t *testing.T) {
+	s := audioSender()
+	for range 128 {
+		s.Input(&rtp.Packet{})
+	}
+	drops := 0
+	s.OnDrop = func() { drops++ }
+	s.InputWithTimeout(&rtp.Packet{}, 5*time.Millisecond)
+	require.Equal(t, 128, len(s.buf))
+	require.Equal(t, 128, cap(s.buf))
+	require.Equal(t, 128, s.Packets)
+	require.Equal(t, 1, s.Drops)
+	require.Equal(t, 1, drops)
+	s.Close()
+}
+func TestBoundedInputCloseUnblocksWaiterWithoutSendAfterClose(t *testing.T) {
+	for range 30 {
+		s := audioSender()
+		for range 128 {
+			s.Input(&rtp.Packet{})
+		}
+		finished := make(chan struct{})
+		go func() { s.InputWithTimeout(&rtp.Packet{}, time.Second); close(finished) }()
+		s.Close()
+		select {
+		case <-finished:
+		case <-time.After(time.Second):
+			t.Fatal("closed queue retained waiter")
+		}
+		require.Equal(t, 0, s.Drops)
+	}
+}
