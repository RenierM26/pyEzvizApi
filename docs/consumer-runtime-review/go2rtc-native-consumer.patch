new file mode 100644
index 0000000..3793808
--- /dev/null
+++ b/pkg/core/sender_timeout.go
@@ -0,0 +1,40 @@
+package core
+
+import "time"
+
+// InputWithTimeout gives an explicit finite consumer bounded backpressure using
+// the existing queue capacity. Legacy Input remains nonblocking/drop-on-full.
+func (s *Sender) InputWithTimeout(packet *Packet, timeout time.Duration) {
+	deadline := time.Now().Add(timeout)
+	for {
+		s.mu.Lock()
+		if s.buf == nil {
+			s.mu.Unlock()
+			return
+		}
+		select {
+		case s.buf <- packet:
+			s.Bytes += len(packet.Payload)
+			s.Packets++
+			s.mu.Unlock()
+			return
+		default:
+		}
+		remaining := time.Until(deadline)
+		if remaining <= 0 {
+			s.Drops++
+			if s.OnDrop != nil {
+				s.OnDrop()
+			}
+			s.mu.Unlock()
+			return
+		}
+		s.mu.Unlock()
+		// Never wait while holding the queue mutex: Start/Close need it too.
+		// One borrowed input is retained; no extra media queue is introduced.
+		if remaining > time.Millisecond {
+			remaining = time.Millisecond
+		}
+		time.Sleep(remaining)
+	}
+}
