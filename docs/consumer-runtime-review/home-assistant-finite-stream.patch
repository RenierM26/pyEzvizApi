+async def test_stream_opaque_generation_and_stop(
+    stream: Stream, hass: HomeAssistant
+) -> None:
+    """Stream opaque generation and stop."""
+    first = stream.async_prepare_finite_source()
+    assert not stream.async_confirm_finite_source(first, FiniteSourceCounts(1, 0))
+    other = Stream(
+        hass, "unused", {}, StreamSettings(True, 5.9, 1, 3, 2), DynamicStreamSettings()
+    )
+    alien = other.async_prepare_finite_source()
+    with pytest.raises(HomeAssistantError):
+        stream.async_prepare_finite_source()
+    assert not stream.async_confirm_finite_source(alien, FiniteSourceCounts(1, 0))
+    assert stream._finite_source.begin()
+    assert stream.async_confirm_finite_source(first, FiniteSourceCounts(1, 0))
+    await stream.stop()
