diff --git a/pkg/rtsp/source_clock.go b/pkg/rtsp/source_clock.go
new file mode 100644
index 0000000..22a4cf5
--- /dev/null
+++ b/pkg/rtsp/source_clock.go
@@ -0,0 +1,149 @@
+package rtsp
+
+// Experimental source-clock assertion for known common-origin MPEG-TS ingests.
+// Not a clock recovery mechanism for arbitrary independently based RTP sources.
+import (
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/pion/rtcp"
+	"github.com/pion/rtp"
+)
+
+type sourceClockMapping struct {
+	mu             sync.Mutex
+	trusted        bool
+	descriptor     *core.SourceClock
+	origin90k      uint64
+	explicitOrigin bool
+	failed         atomic.Bool
+	initialized    bool
+	source, ntp    uint64
+}
+
+func clockFixed(ts, rate uint32) uint64 { return clockFixed64(uint64(ts), rate) }
+
+func clockFixed64(ts uint64, rate uint32) uint64 {
+	return (ts/uint64(rate))<<32 + ((ts%uint64(rate))<<32)/uint64(rate)
+}
+
+func (m *sourceClockMapping) mapTime(source uint64) uint64 {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if !m.initialized {
+		now := time.Now()
+		m.source = source
+		m.ntp = uint64(now.Unix()+2208988800)<<32 + (uint64(now.Nanosecond())<<32)/1000000000
+		m.initialized = true
+	}
+	return m.ntp + source - m.source
+}
+
+type sourceClockSender struct {
+	mapping         *sourceClockMapping
+	rate            uint32
+	sent            bool
+	disabled        bool
+	last, previous  uint32
+	unwrapped       uint64
+	started         bool
+	packets, octets uint32
+}
+
+func (s *sourceClockSender) report(packet *rtp.Packet) []byte {
+	if s.rate == 0 {
+		s.disabled = true
+		if s.mapping != nil {
+			s.mapping.failed.Store(true)
+		}
+		return nil
+	}
+	if s.disabled {
+		return nil
+	}
+	if s.mapping.failed.Load() {
+		s.disabled = true
+		return nil
+	}
+	if !s.started {
+		s.unwrapped = uint64(packet.Timestamp)
+		if s.mapping.explicitOrigin {
+			expected := (s.mapping.origin90k/90000)*uint64(s.rate) + (s.mapping.origin90k%90000)*uint64(s.rate)/90000
+			candidate := (expected & ^uint64(0xffffffff)) | uint64(packet.Timestamp)
+			if candidate+uint64(1)<<31 < expected {
+				candidate += uint64(1) << 32
+			}
+			if candidate > expected+uint64(1)<<31 && candidate >= uint64(1)<<32 {
+				candidate -= uint64(1) << 32
+			}
+			distance := int64(candidate) - int64(expected)
+			if distance < -int64(s.rate)*10 || distance > int64(s.rate)*10 {
+				s.disabled = true
+				s.mapping.failed.Store(true)
+				return nil
+			}
+			s.unwrapped = candidate
+		}
+		s.started = true
+	} else {
+		delta := int64(int32(packet.Timestamp - s.previous))
+		if delta < 0 || delta > int64(s.rate)*10 {
+			s.disabled = true
+			s.mapping.failed.Store(true)
+			return nil
+		}
+		s.unwrapped += uint64(delta)
+	}
+	s.previous = packet.Timestamp
+	var data []byte
+	if !s.sent || packet.Timestamp-s.last >= s.rate/2 {
+		report := &rtcp.SenderReport{
+			SSRC:        packet.SSRC,
+			NTPTime:     s.mapping.mapTime(clockFixed64(s.unwrapped, s.rate)),
+			RTPTime:     packet.Timestamp,
+			PacketCount: s.packets,
+			OctetCount:  s.octets,
+		}
+		cname := rtcp.NewCNAMESourceDescription(packet.SSRC, "source-clock-validation")
+		data, _ = rtcp.Marshal([]rtcp.Packet{report, cname})
+		s.last, s.sent = packet.Timestamp, true
+	}
+	s.packets++
+	s.octets += uint32(len(packet.Payload))
+	return data
+}
+
+// DeferStart is an opt-in cold-consumer handshake, not a new media queue.
+func (c *Conn) DeferStart(start func()) bool {
+	if c.sourceClock == nil {
+		return false
+	}
+	c.sourceStart = start
+	return true
+}
+
+func (c *Conn) sourceEnded(err error) {
+	c.sourceEndMu.Lock()
+	defer c.sourceEndMu.Unlock()
+	if err != nil {
+		c.sourceClock.failed.Store(true)
+		_ = c.Close()
+		return
+	}
+	c.sourceEnds++
+	if c.sourceEnds != len(c.Senders) || c.sourceClock.failed.Load() {
+		return
+	}
+	// All sender queues have drained before any BYE or socket close.
+	bye, _ := rtcp.Marshal([]rtcp.Packet{&rtcp.Goodbye{Sources: []uint32{0}, Reason: "finite source complete"}})
+	for i := range c.Senders {
+		b := make([]byte, 4+len(bye))
+		b[0], b[1] = '$', byte(i*2+1)
+		b[2], b[3] = byte(len(bye)>>8), byte(len(bye))
+		copy(b[4:], bye)
+		_ = c.writeInterleavedData(b)
+	}
+	_ = c.Close()
+}
