+	conn.sourceEnded(io.ErrUnexpectedEOF)
+	b := make([]byte, 1)
+	n, err := right.Read(b)
+	if n != 0 || err != io.EOF || !conn.sourceClock.failed.Load() {
+		t.Fatal("failure became successful BYE", n, err)
+	}
+}
+
+func TestSourceClockBadPacketNeverReachesWire(t *testing.T) {
+	left, right := net.Pipe()
+	defer right.Close()
+	defer left.Close()
+	right.SetReadDeadline(time.Now().Add(2 * time.Second))
+	conn := NewServer(left)
+	conn.sourceClock = &sourceClockMapping{origin90k: 90000, explicitOrigin: true}
+	conn.state = StatePlay
+	conn.playOK = true
+	send := conn.packetWriter(&core.Codec{Name: core.CodecAAC, ClockRate: 16000, PayloadType: 97}, 2, 97)
+	done := make(chan struct{})
+	go func() {
+		send(&rtp.Packet{Header: rtp.Header{Version: 2, Marker: true, Timestamp: 16000}, Payload: []byte{1}})
+		send(&rtp.Packet{Header: rtp.Header{Version: 2, Marker: true, Timestamp: 15999}, Payload: []byte{2}})
+		close(done)
+	}()
+	for i := 0; i < 2; i++ {
+		h := make([]byte, 4)
+		if _, e := io.ReadFull(right, h); e != nil {
+			t.Fatal(e)
+		}
+		b := make([]byte, int(h[2])<<8|int(h[3]))
+		if _, e := io.ReadFull(right, b); e != nil {
+			t.Fatal(e)
+		}
+	}
+	b := make([]byte, 1)
+	n, err := right.Read(b)
+	if n != 0 || err != io.EOF || !conn.sourceClock.failed.Load() {
+		t.Fatal("invalid media escaped", n, err)
+	}
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("writer blocked")
+	}
+}
