+	done := make(chan []byte, 1)
+	go func() { b, _ := io.ReadAll(right); done <- b }()
+	video.WriteRTP(&rtp.Packet{Header: rtp.Header{Timestamp: 90000}, Payload: []byte{0, 0, 0, 2, 0x65, 0x80}})
+	video.End(nil)
+	select {
+	case b := <-done:
+		if !c.sourceClock.failed.Load() {
+			t.Fatal("single AU declared complete")
+		}
+		for len(b) >= 4 {
+			n := int(b[2])<<8 | int(b[3])
+			if len(b) < 4+n {
+				break
+			}
+			if b[1]%2 == 1 {
+				packets, _ := rtcp.Unmarshal(b[4 : 4+n])
+				for _, p := range packets {
+					if _, ok := p.(*rtcp.Goodbye); ok {
+						t.Fatal("success BYE after missing parser boundary")
+					}
+				}
+			}
+			b = b[4+n:]
+		}
+	case <-time.After(time.Second):
+		t.Fatal("single AU shutdown blocked")
+	}
+}
+
+func TestSourceClockAudioFirstTerminalJoin(t *testing.T) {
+	for _, pictures := range []int{0, 1, 2} {
+		for _, failed := range []bool{false, true} {
+			t.Run(fmt.Sprintf("pictures_%d_error_%t", pictures, failed), func(t *testing.T) {
+				left, right := net.Pipe()
+				defer left.Close()
+				defer right.Close()
+				c := NewServer(left)
+				c.sourceClock = &sourceClockMapping{}
+				c.mode = core.ModePassiveConsumer
+				c.sourceVideoReady = make(chan struct{})
+				c.sourceClosed = make(chan struct{})
+				am, vm := &core.Media{Kind: core.KindAudio}, &core.Media{Kind: core.KindVideo}
+				ac := &core.Codec{Name: core.CodecAAC, ClockRate: 16000, PayloadType: core.PayloadTypeRAW}
+				vc := &core.Codec{Name: core.CodecH264, ClockRate: 90000, PayloadType: core.PayloadTypeRAW}
+				audio, video := core.NewReceiver(am, ac), core.NewReceiver(vm, vc)
+				if err := c.AddTrack(am, ac, audio); err != nil {
+					t.Fatal(err)
+				}
+				if err := c.AddTrack(vm, vc, video); err != nil {
+					t.Fatal(err)
+				}
+				wire := make(chan []byte, 1)
+				go func() { body, _ := io.ReadAll(right); wire <- body }()
+				audio.WriteRTP(&rtp.Packet{Header: rtp.Header{Timestamp: 16000}, Payload: []byte{1, 2, 3}})
+				for i := 0; i < pictures; i++ {
+					video.WriteRTP(&rtp.Packet{Header: rtp.Header{Timestamp: uint32(90000 + i*9000)}, Payload: []byte{0, 0, 0, 2, 0x65, 0x80}})
+				}
+				var sourceError error
+				if failed {
+					sourceError = io.ErrClosedPipe
+				}
+				entered, audioDone, videoDone := make(chan struct{}), make(chan struct{}), make(chan struct{})
+				onEnd := c.Senders[0].OnEnd
+				c.Senders[0].OnEnd = func(err error) { close(entered); onEnd(err) }
+				go func() { audio.End(sourceError); close(audioDone) }()
+				<-entered
+				go func() { video.End(sourceError); close(videoDone) }()
+				for _, done := range []chan struct{}{audioDone, videoDone} {
+					select {
+					case <-done:
+					case <-time.After(time.Second):
+						_ = c.Close()
+						t.Fatal("terminal sender did not join")
+					}
+				}
+				var body []byte
+				select {
+				case body = <-wire:
+				case <-time.After(time.Second):
+					t.Fatal("terminal socket remained open")
+				}
+				bye, audioPackets := 0, 0
+				for len(body) >= 4 {
+					size := int(body[2])<<8 | int(body[3])
+					if len(body) < size+4 {
+						t.Fatal("partial interleaved output")
+					}
+					if body[1] == 0 {
+						audioPackets++
+					}
+					if body[1]%2 == 1 {
+						packets, err := rtcp.Unmarshal(body[4 : 4+size])
+						if err != nil {
+							t.Fatal(err)
+						}
+						for _, packet := range packets {
+							if _, ok := packet.(*rtcp.Goodbye); ok {
+								bye++
+							}
+						}
+					}
+					body = body[4+size:]
+				}
+				if failed || pictures < 2 {
+					if !c.sourceClock.failed.Load() || bye != 0 {
+						t.Fatal("failed/short source declared successful")
+					}
+					if pictures < 2 && audioPackets != 0 {
+						t.Fatal("audio escaped before parser boundary")
+					}
+				} else if c.sourceClock.failed.Load() || bye != 2 || audioPackets != 1 {
+					t.Fatal("complete source did not drain both tracks", bye, audioPackets)
+				}
+			})
+		}
+	}
+}
