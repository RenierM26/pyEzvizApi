+func TestSourceClockCommonOffset(t *testing.T) {
+	m := &sourceClockMapping{}
+	video := sourceClockSender{mapping: m, rate: 90000}
+	audio := sourceClockSender{mapping: m, rate: 16000}
+	a, _ := rtcp.Unmarshal(video.report(&rtp.Packet{Header: rtp.Header{Timestamp: 90000, SSRC: 10}, Payload: []byte{1, 2}}))
+	b, _ := rtcp.Unmarshal(audio.report(&rtp.Packet{Header: rtp.Header{Timestamp: 17600, SSRC: 20}, Payload: []byte{3}}))
+	srA, srB := a[0].(*rtcp.SenderReport), b[0].(*rtcp.SenderReport)
+	delta := srB.NTPTime - srA.NTPTime
+	if delta != (uint64(1)<<32)/10 {
+		t.Fatalf("offset changed: %d", delta)
+	}
+	if len(a) != 2 || len(b) != 2 {
+		t.Fatal("missing compound SDES")
+	}
+	if srA.RTPTime != 90000 || srB.RTPTime != 17600 {
+		t.Fatal("RTP rewritten")
+	}
+	if video.report(&rtp.Packet{Header: rtp.Header{Timestamp: 90001}}) != nil {
+		t.Fatal("unbounded reports")
+	}
+	if video.report(&rtp.Packet{Header: rtp.Header{Timestamp: 135000}}) == nil {
+		t.Fatal("periodic report absent")
+	}
+}
+
+func TestSourceClockRejectsBackwardAndZeroRate(t *testing.T) {
+	s := sourceClockSender{mapping: &sourceClockMapping{}, rate: 90000}
+	s.report(&rtp.Packet{Header: rtp.Header{Timestamp: 90000}})
+	if s.report(&rtp.Packet{Header: rtp.Header{Timestamp: 89999}}) != nil || !s.disabled {
+		t.Fatal("backward clock repaired")
+	}
+	z := sourceClockSender{mapping: &sourceClockMapping{}}
+	if z.report(&rtp.Packet{}) != nil {
+		t.Fatal("zero rate accepted")
+	}
+}
+
+func TestSourceClockConcurrentAnchor(t *testing.T) {
+	m := &sourceClockMapping{}
+	var wg sync.WaitGroup
+	values := make([]uint64, 16)
+	for i := range values {
+		wg.Add(1)
+		go func(i int) { defer wg.Done(); values[i] = m.mapTime(uint64(1) << 32) }(i)
+	}
+	wg.Wait()
+	for _, v := range values {
+		if v != values[0] {
+			t.Fatal("anchor race")
+		}
+	}
+}
+
+func TestSourceClockWriterOptInAndPayload(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		t.Run(map[bool]string{false: "default", true: "opt-in"}[enabled], func(t *testing.T) {
+			left, right := net.Pipe()
+			defer left.Close()
+			defer right.Close()
+			right.SetReadDeadline(time.Now().Add(2 * time.Second))
+			conn := NewServer(left)
+			conn.state = StatePlay
+			conn.playOK = true
+			if enabled {
+				conn.sourceClock = &sourceClockMapping{}
+			}
+			send := conn.packetWriter(&core.Codec{Name: core.CodecAAC, ClockRate: 16000, PayloadType: 97}, 2, 97)
+			packet := &rtp.Packet{Header: rtp.Header{Version: 2, Marker: false, Timestamp: 16000, SequenceNumber: 7, SSRC: 40}, Payload: []byte{1, 2, 3}}
+			done := make(chan struct{})
+			go func() { send(packet); close(done) }()
+			read := func() (byte, []byte) {
+				h := make([]byte, 4)
+				if _, err := io.ReadFull(right, h); err != nil {
+					t.Fatal(err)
+				}
+				b := make([]byte, int(h[2])<<8|int(h[3]))
+				if _, err := io.ReadFull(right, b); err != nil {
+					t.Fatal(err)
+				}
+				if h[0] != '$' {
+					t.Fatal("invalid interleaving")
+				}
+				return h[1], b
+			}
+			channel, body := read()
+			if enabled {
+				if channel != 3 {
+					t.Fatal("missing RTCP before RTP")
+				}
+				reports, err := rtcp.Unmarshal(body)
+				if err != nil || len(reports) != 2 {
+					t.Fatal("bad compound report", err)
+				}
+				sr := reports[0].(*rtcp.SenderReport)
+				if sr.RTPTime != 16000 || sr.SSRC != 40 {
+					t.Fatal("bad SR identity")
+				}
+				channel, body = read()
+			}
+			if channel != 2 {
+				t.Fatal("default behavior changed")
+			}
+			got := &rtp.Packet{}
+			if err := got.Unmarshal(body); err != nil {
+				t.Fatal(err)
+			}
+			if got.Timestamp != packet.Timestamp || got.SequenceNumber != packet.SequenceNumber || !bytes.Equal(got.Payload, packet.Payload) {
+				t.Fatal("media changed")
+			}
+			if !got.Marker || packet.Marker {
+				t.Fatal("audio marker mutated shared input")
+			}
+			select {
+			case <-done:
+			case <-time.After(time.Second):
+				t.Fatal("writer did not finish")
+			}
+		})
+	}
+}
