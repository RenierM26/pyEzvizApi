index 0000000..5b6d8b4
--- /dev/null
+++ b/pkg/webrtc/native_auto_feedback_test.go
@@ -0,0 +1,335 @@
+package webrtc
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/pion/ice/v4"
+	"github.com/pion/interceptor"
+	"github.com/pion/rtcp"
+	"github.com/pion/rtp"
+	pion "github.com/pion/webrtc/v4"
+)
+
+// A receiver must be able to repair a burst after its primary SRTP replay
+// window advances, without increasing that window or the retransmission cache.
+func TestNativeAutomaticRecovery(t *testing.T) {
+	for _, profile := range []struct{ name, codec, fmtp string }{
+		{"H264-baseline", core.CodecH264, "level-asymmetry-allowed=1;packetization-mode=1;profile-level-id=42001f"},
+		{"H264-constrained", core.CodecH264, "level-asymmetry-allowed=1;packetization-mode=1;profile-level-id=42e01f"},
+		{"H264-high", core.CodecH264, "level-asymmetry-allowed=1;packetization-mode=1;profile-level-id=640032"},
+		{"H265", core.CodecH265, ""},
+	} {
+		for _, scenario := range []struct {
+			name           string
+			rtx            bool
+			total, missing uint16
+			recovered      bool
+			continuation   bool
+		}{
+			{"automatic_late_burst_and_lost_repair", true, 256, 74, true, true},
+			{"terminal_repair_without_more_primary", true, 256, 74, true, false},
+			{"no_rtx_early_feedback", false, 32, 16, true, false},
+			{"no_rtx_keeps_replay_protection", false, 256, 74, false, false},
+		} {
+			t.Run(profile.name+"/"+scenario.name, func(t *testing.T) {
+				nativeAutomaticRecovery(t, profile.codec, profile.fmtp, scenario.rtx, scenario.total, scenario.missing, scenario.recovered, scenario.continuation)
+			})
+		}
+	}
+}
+
+func nativeAutomaticRecovery(t *testing.T, codec, fmtp string, offerRTX bool, total, missingCount uint16, recovered, continuation bool) {
+	old := OnNewListener
+	OnNewListener = func(v any) {
+		if closer, ok := v.(io.Closer); ok {
+			t.Cleanup(func() { _ = closer.Close() })
+		}
+	}
+	api, err := NewServerAPI("udp", "127.0.0.1:0", &Filters{Loopback: true, Interfaces: []string{"lo"}, Networks: []string{"udp4"}})
+	OnNewListener = old
+	if err != nil {
+		t.Fatal(err)
+	}
+	pc, err := api.NewPeerConnection(pion.Configuration{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := NewConn(pc)
+	c.Mode = core.ModePassiveConsumer
+	defer c.Close()
+	m := &pion.MediaEngine{}
+	mime, nal := pion.MimeTypeH265, []byte{0x26, 1, 5, 6, 7}
+	if codec == core.CodecH264 {
+		mime = pion.MimeTypeH264
+		nal = []byte{0x65, 5, 6, 7}
+	}
+	if err = m.RegisterCodec(pion.RTPCodecParameters{RTPCodecCapability: pion.RTPCodecCapability{MimeType: mime, ClockRate: 90000, SDPFmtpLine: fmtp, RTCPFeedback: []pion.RTCPFeedback{{Type: "nack"}}}, PayloadType: 96}, pion.RTPCodecTypeVideo); err != nil {
+		t.Fatal(err)
+	}
+	if offerRTX {
+		if err = m.RegisterCodec(pion.RTPCodecParameters{RTPCodecCapability: pion.RTPCodecCapability{MimeType: pion.MimeTypeRTX, ClockRate: 90000, SDPFmtpLine: "apt=96"}, PayloadType: 97}, pion.RTPCodecTypeVideo); err != nil {
+			t.Fatal(err)
+		}
+	}
+	socket, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.ParseIP("127.0.0.1")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	loss := &nativeAutoLossConn{PacketConn: socket, dropped: map[uint16]bool{}, last: missingCount + 1, dropFirstRTX: offerRTX}
+	mux := ice.NewUDPMuxDefault(ice.UDPMuxParams{UDPConn: loss})
+	defer mux.Close()
+	se := pion.SettingEngine{}
+	se.SetICEUDPMux(mux)
+	se.SetIncludeLoopbackCandidate(true)
+	se.SetInterfaceFilter(func(name string) bool { return name == "lo" })
+	se.SetNetworkTypes([]pion.NetworkType{pion.NetworkTypeUDP4})
+	gate := &automaticFeedbackGate{}
+	registry := &interceptor.Registry{}
+	registry.Add(gate)
+	if err = pion.RegisterDefaultInterceptors(m, registry); err != nil {
+		t.Fatal(err)
+	}
+	remote, err := pion.NewAPI(pion.WithMediaEngine(m), pion.WithSettingEngine(se), pion.WithInterceptorRegistry(registry)).NewPeerConnection(pion.Configuration{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer remote.Close()
+	connected := make(chan struct{}, 1)
+	remote.OnConnectionStateChange(func(state pion.PeerConnectionState) {
+		if state == pion.PeerConnectionStateConnected {
+			select {
+			case connected <- struct{}{}:
+			default:
+			}
+		}
+	})
+	type receipt struct {
+		found map[uint16][]byte
+		err   error
+	}
+	result := make(chan receipt, 1)
+	remote.OnTrack(func(track *pion.TrackRemote, _ *pion.RTPReceiver) {
+		_ = track.SetReadDeadline(time.Now().Add(3 * time.Second))
+		found := map[uint16][]byte{}
+		requested := false
+		highest := uint16(0)
+		for {
+			packet, _, readErr := track.ReadRTP()
+			if readErr != nil {
+				result <- receipt{found, readErr}
+				return
+			}
+			found[packet.SequenceNumber] = append([]byte(nil), packet.Payload...)
+			if packet.SequenceNumber > highest {
+				highest = packet.SequenceNumber
+			}
+			if highest >= total && !requested {
+				gate.ready.Store(true)
+				requested = true
+				_ = track.SetReadDeadline(time.Now().Add(500 * time.Millisecond))
+			}
+			complete := requested
+			for seq := uint16(1); complete && seq <= total; seq++ {
+				_, complete = found[seq]
+			}
+			if complete {
+				result <- receipt{found, nil}
+				return
+			}
+		}
+	})
+	if _, err = remote.AddTransceiverFromKind(pion.RTPCodecTypeVideo, pion.RTPTransceiverInit{Direction: pion.RTPTransceiverDirectionRecvonly}); err != nil {
+		t.Fatal(err)
+	}
+	offer, err := remote.CreateOffer(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	gathered := pion.GatheringCompletePromise(remote)
+	if err = remote.SetLocalDescription(offer); err != nil {
+		t.Fatal(err)
+	}
+	<-gathered
+	if err = c.SetOffer(remote.LocalDescription().SDP); err != nil {
+		t.Fatal(err)
+	}
+	media := c.Medias[0]
+	inputCodec := &core.Codec{Name: codec, ClockRate: 90000, PayloadType: 96}
+	input := core.NewReceiver(&core.Media{Kind: core.KindVideo, Direction: core.DirectionRecvonly, Codecs: []*core.Codec{inputCodec}}, inputCodec)
+	input.SourcePolicy = &core.SourcePolicy{OneShot: true}
+	if err = c.AddTrack(media, media.Codecs[0], input); err != nil {
+		t.Fatal(err)
+	}
+	gathered = pion.GatheringCompletePromise(pc)
+	if _, err = c.GetAnswer(); err != nil {
+		t.Fatal(err)
+	}
+	<-gathered
+	if err = remote.SetRemoteDescription(*pc.LocalDescription()); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-connected:
+	case <-time.After(3 * time.Second):
+		t.Fatal("connect timeout")
+	}
+	writePacket := func(i uint16) {
+		payload := append(append([]byte(nil), nal...), byte(i>>8), byte(i))
+		input.WriteRTP(&rtp.Packet{Header: rtp.Header{Version: 2, Marker: true, SequenceNumber: i, Timestamp: uint32(i) * 3000}, Payload: payload})
+	}
+	for i := uint16(1); i <= total; i++ {
+		writePacket(i)
+	}
+	// Continue ordinary media for the running-source case. The repair-only
+	// control disables this path so it cannot mask a blocked primary read.
+	stop := make(chan struct{})
+	var continuing sync.WaitGroup
+	continuing.Add(1)
+	go func() {
+		defer continuing.Done()
+		if !continuation {
+			return
+		}
+		for i := total + 1; i <= total+100; i++ {
+			select {
+			case <-stop:
+				return
+			case <-time.After(5 * time.Millisecond):
+				writePacket(i)
+			}
+		}
+	}()
+	defer func() { close(stop); continuing.Wait() }()
+
+	select {
+	case got := <-result:
+		loss.mu.Lock()
+		dropped, rtx, resent, lostRepair := len(loss.dropped), loss.rtx, loss.resent, loss.rtxDropped
+		loss.mu.Unlock()
+		if dropped != int(missingCount) {
+			t.Fatalf("drop count=%d", dropped)
+		}
+		if recovered {
+			if got.err != nil {
+				t.Fatalf("late burst unrecovered: unique=%d want=%d err=%v feedback=%d rtx=%d", len(got.found), total, got.err, c.nativeFeedbackPackets.Load(), rtx)
+			}
+			if offerRTX {
+				if rtx <= int(missingCount) || !lostRepair {
+					t.Fatalf("RTX packets=%d lost-first-repair=%v", rtx, lostRepair)
+				}
+			} else if rtx != 0 || resent < int(missingCount) {
+				t.Fatalf("early same-SSRC recovery: RTX=%d resends=%d", rtx, resent)
+			}
+		} else {
+			var timeout net.Error
+			if !errors.As(got.err, &timeout) || !timeout.Timeout() {
+				t.Fatalf("expected bounded timeout, got %v", got.err)
+			}
+			last := uint16(0)
+			for seq := range got.found {
+				if seq > last {
+					last = seq
+				}
+			}
+			if len(got.found) != int(last)-int(missingCount) {
+				t.Fatalf("unexpected recovery/extra loss: unique=%d last=%d", len(got.found), last)
+			}
+			if offerRTX && rtx != 0 {
+				t.Fatalf("expired cache produced %d RTX packets", rtx)
+			}
+			if !offerRTX && resent < int(missingCount) {
+				t.Fatalf("same-SSRC repairs=%d want>=%d", resent, missingCount)
+			}
+		}
+		for seq, payload := range got.found {
+			expected := append(append([]byte(nil), nal...), byte(seq>>8), byte(seq))
+			if !bytes.Equal(payload, expected) {
+				t.Fatalf("payload changed seq=%d: %x != %x", seq, payload, expected)
+			}
+		}
+		if c.nativeFeedbackPackets.Load() == 0 {
+			t.Fatal("NACK not read by native sender")
+		}
+	case <-time.After(4 * time.Second):
+		t.Fatal("receiver timeout")
+	}
+}
+
+type nativeAutoLossConn struct {
+	net.PacketConn
+	mu           sync.Mutex
+	dropped      map[uint16]bool
+	rtx          int
+	resent       int
+	last         uint16
+	dropFirstRTX bool
+	rtxDropped   bool
+}
+
+func (c *nativeAutoLossConn) ReadFrom(b []byte) (int, net.Addr, error) {
+	for {
+		n, addr, err := c.PacketConn.ReadFrom(b)
+		if err != nil {
+			return n, addr, err
+		}
+		if n >= 12 && b[0]>>6 == 2 {
+			pt := b[1] & 0x7f
+			seq := binary.BigEndian.Uint16(b[2:4])
+			c.mu.Lock()
+			drop := false
+			if pt == 96 && seq >= 2 && seq <= c.last {
+				if !c.dropped[seq] {
+					c.dropped[seq] = true
+					drop = true
+				} else {
+					c.resent++
+				}
+			}
+			if pt == 97 {
+				c.rtx++
+				if c.dropFirstRTX && !c.rtxDropped {
+					c.rtxDropped = true
+					drop = true
+				}
+			}
+			c.mu.Unlock()
+			if drop {
+				continue
+			}
+		}
+		return n, addr, nil
+	}
+}
+
+type automaticFeedbackGate struct {
+	interceptor.NoOp
+	ready atomic.Bool
+}
+
+func (g *automaticFeedbackGate) NewInterceptor(string) (interceptor.Interceptor, error) {
+	return g, nil
+}
+func (g *automaticFeedbackGate) BindRTCPWriter(writer interceptor.RTCPWriter) interceptor.RTCPWriter {
+	return interceptor.RTCPWriterFunc(func(packets []rtcp.Packet, attributes interceptor.Attributes) (int, error) {
+		out := make([]rtcp.Packet, 0, len(packets))
+		for _, packet := range packets {
+			if _, ok := packet.(*rtcp.TransportLayerNack); ok && !g.ready.Load() {
+				continue
+			}
+			out = append(out, packet)
+		}
+		if len(out) == 0 {
+			return 0, nil
+		}
+		return writer.Write(out, attributes)
+	})
+}
diff --git a/pkg/webrtc/native_feedback_test.go b/pkg/webrtc/native_feedback_test.go
new file mode 100644
index 0000000..8479d54
--- /dev/null
+++ b/pkg/webrtc/native_feedback_test.go
@@ -0,0 +1,147 @@
+package webrtc
+
+import (
+	"bytes"
+	"encoding/binary"
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/pion/ice/v4"
+	"github.com/pion/rtp"
+	pion "github.com/pion/webrtc/v4"
+	"io"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestNativeFeedbackRecoversRequestedPacket(t *testing.T) {
+	old := OnNewListener
+	OnNewListener = func(v any) {
+		if c, ok := v.(io.Closer); ok {
+			t.Cleanup(func() { _ = c.Close() })
+		}
+	}
+	api, err := NewServerAPI("udp", "127.0.0.1:0", &Filters{Loopback: true, Interfaces: []string{"lo"}, Networks: []string{"udp4"}})
+	OnNewListener = old
+	if err != nil {
+		t.Fatal(err)
+	}
+	pc, err := api.NewPeerConnection(pion.Configuration{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := NewConn(pc)
+	c.Mode = core.ModePassiveConsumer
+	defer c.Close()
+	m := &pion.MediaEngine{}
+	if err = m.RegisterCodec(pion.RTPCodecParameters{RTPCodecCapability: pion.RTPCodecCapability{MimeType: "video/H265", ClockRate: 90000, RTCPFeedback: []pion.RTCPFeedback{{Type: "nack"}}}, PayloadType: 96}, pion.RTPCodecTypeVideo); err != nil {
+		t.Fatal(err)
+	}
+	socket, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.ParseIP("127.0.0.1")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	loss := &nativeLossConn{PacketConn: socket}
+	mux := ice.NewUDPMuxDefault(ice.UDPMuxParams{UDPConn: loss})
+	defer mux.Close()
+	se := pion.SettingEngine{}
+	se.SetICEUDPMux(mux)
+	se.SetIncludeLoopbackCandidate(true)
+	se.SetInterfaceFilter(func(name string) bool { return name == "lo" })
+	se.SetNetworkTypes([]pion.NetworkType{pion.NetworkTypeUDP4})
+	remote, err := pion.NewAPI(pion.WithMediaEngine(m), pion.WithSettingEngine(se)).NewPeerConnection(pion.Configuration{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer remote.Close()
+	connected := make(chan struct{}, 1)
+	remote.OnConnectionStateChange(func(s pion.PeerConnectionState) {
+		if s == pion.PeerConnectionStateConnected {
+			connected <- struct{}{}
+		}
+	})
+	result := make(chan error, 1)
+	remote.OnTrack(func(track *pion.TrackRemote, _ *pion.RTPReceiver) {
+		_ = track.SetReadDeadline(time.Now().Add(2 * time.Second))
+		found := map[uint16][]byte{}
+		for len(found) < 8 {
+			packet, _, e := track.ReadRTP()
+			if e != nil {
+				result <- e
+				return
+			}
+			found[packet.SequenceNumber] = packet.Payload
+		}
+		if !bytes.Equal(found[1], found[2]) || !bytes.Equal(found[2], found[3]) {
+			result <- io.ErrUnexpectedEOF
+			return
+		}
+		result <- nil
+	})
+	_, err = remote.AddTransceiverFromKind(pion.RTPCodecTypeVideo, pion.RTPTransceiverInit{Direction: pion.RTPTransceiverDirectionRecvonly})
+	if err != nil {
+		t.Fatal(err)
+	}
+	offer, err := remote.CreateOffer(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	done := pion.GatheringCompletePromise(remote)
+	if err = remote.SetLocalDescription(offer); err != nil {
+		t.Fatal(err)
+	}
+	<-done
+	if err = c.SetOffer(remote.LocalDescription().SDP); err != nil {
+		t.Fatal(err)
+	}
+	media := c.Medias[0]
+	codec := &core.Codec{Name: core.CodecH265, ClockRate: 90000, PayloadType: 96}
+	input := core.NewReceiver(&core.Media{Kind: core.KindVideo, Direction: core.DirectionRecvonly, Codecs: []*core.Codec{codec}}, codec)
+	input.SourcePolicy = &core.SourcePolicy{OneShot: true}
+	if err = c.AddTrack(media, media.Codecs[0], input); err != nil {
+		t.Fatal(err)
+	}
+	gathered := pion.GatheringCompletePromise(pc)
+	if _, err = c.GetAnswer(); err != nil {
+		t.Fatal(err)
+	}
+	<-gathered
+	if err = remote.SetRemoteDescription(*pc.LocalDescription()); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-connected:
+	case <-time.After(3 * time.Second):
+		t.Fatal("loopback connection timeout")
+	}
+	t.Logf("sender codecs: %+v", pc.GetSenders()[0].GetParameters().Codecs)
+	for i := 0; i < 8; i++ {
+		input.WriteRTP(&rtp.Packet{Header: rtp.Header{Version: 2, Marker: true, SequenceNumber: uint16(i + 1), Timestamp: uint32(90000 + i*6000)}, Payload: []byte{0x26, 1, 5, 6, 7}})
+	}
+	select {
+	case err = <-result:
+		if err != nil {
+			t.Fatalf("NACK recovery: %v feedback=%d", err, c.nativeFeedbackPackets.Load())
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatalf("NACK recovery timeout feedback=%d", c.nativeFeedbackPackets.Load())
+	}
+}
+
+type nativeLossConn struct {
+	net.PacketConn
+	dropped atomic.Bool
+}
+
+func (c *nativeLossConn) ReadFrom(b []byte) (int, net.Addr, error) {
+	for {
+		n, addr, err := c.PacketConn.ReadFrom(b)
+		if err != nil {
+			return n, addr, err
+		}
+		if n >= 12 && b[0]>>6 == 2 && b[1]&0x7f == 96 && binary.BigEndian.Uint16(b[2:4]) == 2 && c.dropped.CompareAndSwap(false, true) {
+			continue
+		}
+		return n, addr, nil
+	}
+}
diff --git a/pkg/webrtc/native_recovery_test.go b/pkg/webrtc/native_recovery_test.go
new file mode 100644
index 0000000..1d5dbb2
--- /dev/null
+++ b/pkg/webrtc/native_recovery_test.go
@@ -0,0 +1,318 @@
+package webrtc
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/pion/ice/v4"
+	"github.com/pion/interceptor"
+	"github.com/pion/rtcp"
+	"github.com/pion/rtp"
+	pion "github.com/pion/webrtc/v4"
+)
+
+// A receiver must be able to repair a burst after its primary SRTP replay
+// window advances, without increasing that window or the retransmission cache.
+func TestNativeRecoveryLateFeedback(t *testing.T) {
+	for _, profile := range []struct{ name, codec, fmtp string }{
+		{"H264-baseline", core.CodecH264, "level-asymmetry-allowed=1;packetization-mode=1;profile-level-id=42001f"},
+		{"H264-constrained", core.CodecH264, "level-asymmetry-allowed=1;packetization-mode=1;profile-level-id=42e01f"},
+		{"H264-high", core.CodecH264, "level-asymmetry-allowed=1;packetization-mode=1;profile-level-id=640032"},
+		{"H265", core.CodecH265, ""},
+	} {
+		for _, scenario := range []struct {
+			name           string
+			rtx            bool
+			total, missing uint16
+			recovered      bool
+		}{
+			{"negotiated_rtx_late_burst_and_lost_repair", true, 256, 74, true},
+			{"no_rtx_early_feedback", false, 32, 16, true},
+			{"no_rtx_keeps_replay_protection", false, 256, 74, false},
+			{"expired_cache_stays_bounded", true, 1200, 74, false},
+		} {
+			t.Run(profile.name+"/"+scenario.name, func(t *testing.T) {
+				nativeRecoveryLateFeedback(t, profile.codec, profile.fmtp, scenario.rtx, scenario.total, scenario.missing, scenario.recovered)
+			})
+		}
+	}
+}
+
+func nativeRecoveryLateFeedback(t *testing.T, codec, fmtp string, offerRTX bool, total, missingCount uint16, recovered bool) {
+	old := OnNewListener
+	OnNewListener = func(v any) {
+		if closer, ok := v.(io.Closer); ok {
+			t.Cleanup(func() { _ = closer.Close() })
+		}
+	}
+	api, err := NewServerAPI("udp", "127.0.0.1:0", &Filters{Loopback: true, Interfaces: []string{"lo"}, Networks: []string{"udp4"}})
+	OnNewListener = old
+	if err != nil {
+		t.Fatal(err)
+	}
+	pc, err := api.NewPeerConnection(pion.Configuration{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := NewConn(pc)
+	c.Mode = core.ModePassiveConsumer
+	defer c.Close()
+	m := &pion.MediaEngine{}
+	mime, nal := pion.MimeTypeH265, []byte{0x26, 1, 5, 6, 7}
+	if codec == core.CodecH264 {
+		mime = pion.MimeTypeH264
+		nal = []byte{0x65, 5, 6, 7}
+	}
+	if err = m.RegisterCodec(pion.RTPCodecParameters{RTPCodecCapability: pion.RTPCodecCapability{MimeType: mime, ClockRate: 90000, SDPFmtpLine: fmtp, RTCPFeedback: []pion.RTCPFeedback{{Type: "nack"}}}, PayloadType: 96}, pion.RTPCodecTypeVideo); err != nil {
+		t.Fatal(err)
+	}
+	if offerRTX {
+		if err = m.RegisterCodec(pion.RTPCodecParameters{RTPCodecCapability: pion.RTPCodecCapability{MimeType: pion.MimeTypeRTX, ClockRate: 90000, SDPFmtpLine: "apt=96"}, PayloadType: 97}, pion.RTPCodecTypeVideo); err != nil {
+			t.Fatal(err)
+		}
+	}
+	socket, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.ParseIP("127.0.0.1")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	loss := &nativeBurstLossConn{PacketConn: socket, dropped: map[uint16]bool{}, last: missingCount + 1, dropFirstRTX: offerRTX}
+	mux := ice.NewUDPMuxDefault(ice.UDPMuxParams{UDPConn: loss})
+	defer mux.Close()
+	se := pion.SettingEngine{}
+	se.SetICEUDPMux(mux)
+	se.SetIncludeLoopbackCandidate(true)
+	se.SetInterfaceFilter(func(name string) bool { return name == "lo" })
+	se.SetNetworkTypes([]pion.NetworkType{pion.NetworkTypeUDP4})
+	// Manual feedback is generated from the receiver's restored original
+	// sequence inventory. Delay its first request past the unchanged SRTP
+	// replay window, and retry only still-missing packets, not repaired ones.
+	remote, err := pion.NewAPI(pion.WithMediaEngine(m), pion.WithSettingEngine(se), pion.WithInterceptorRegistry(&interceptor.Registry{})).NewPeerConnection(pion.Configuration{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer remote.Close()
+	connected := make(chan struct{}, 1)
+	remote.OnConnectionStateChange(func(state pion.PeerConnectionState) {
+		if state == pion.PeerConnectionStateConnected {
+			select {
+			case connected <- struct{}{}:
+			default:
+			}
+		}
+	})
+	type receipt struct {
+		found map[uint16][]byte
+		err   error
+	}
+	result := make(chan receipt, 1)
+	remote.OnTrack(func(track *pion.TrackRemote, _ *pion.RTPReceiver) {
+		_ = track.SetReadDeadline(time.Now().Add(3 * time.Second))
+		found := map[uint16][]byte{}
+		requested := false
+		highest := uint16(0)
+		var lastNack time.Time
+		for {
+			packet, _, readErr := track.ReadRTP()
+			if readErr != nil {
+				result <- receipt{found, readErr}
+				return
+			}
+			found[packet.SequenceNumber] = append([]byte(nil), packet.Payload...)
+			if packet.SequenceNumber > highest {
+				highest = packet.SequenceNumber
+			}
+			if highest >= total && time.Since(lastNack) >= 75*time.Millisecond {
+				missing := make([]uint16, 0, missingCount)
+				for seq := uint16(2); seq <= missingCount+1; seq++ {
+					if _, ok := found[seq]; !ok {
+						missing = append(missing, seq)
+					}
+				}
+				if len(missing) > 0 {
+					if writeErr := remote.WriteRTCP([]rtcp.Packet{&rtcp.TransportLayerNack{MediaSSRC: uint32(track.SSRC()), Nacks: rtcp.NackPairsFromSequenceNumbers(missing)}}); writeErr != nil {
+						result <- receipt{found, writeErr}
+						return
+					}
+					lastNack = time.Now()
+				}
+				if !requested {
+					_ = track.SetReadDeadline(time.Now().Add(500 * time.Millisecond))
+					requested = true
+				}
+			}
+			complete := requested
+			for seq := uint16(1); complete && seq <= total; seq++ {
+				_, complete = found[seq]
+			}
+			if complete {
+				result <- receipt{found, nil}
+				return
+			}
+		}
+	})
+	if _, err = remote.AddTransceiverFromKind(pion.RTPCodecTypeVideo, pion.RTPTransceiverInit{Direction: pion.RTPTransceiverDirectionRecvonly}); err != nil {
+		t.Fatal(err)
+	}
+	offer, err := remote.CreateOffer(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	gathered := pion.GatheringCompletePromise(remote)
+	if err = remote.SetLocalDescription(offer); err != nil {
+		t.Fatal(err)
+	}
+	<-gathered
+	if err = c.SetOffer(remote.LocalDescription().SDP); err != nil {
+		t.Fatal(err)
+	}
+	media := c.Medias[0]
+	inputCodec := &core.Codec{Name: codec, ClockRate: 90000, PayloadType: 96}
+	input := core.NewReceiver(&core.Media{Kind: core.KindVideo, Direction: core.DirectionRecvonly, Codecs: []*core.Codec{inputCodec}}, inputCodec)
+	input.SourcePolicy = &core.SourcePolicy{OneShot: true}
+	if err = c.AddTrack(media, media.Codecs[0], input); err != nil {
+		t.Fatal(err)
+	}
+	gathered = pion.GatheringCompletePromise(pc)
+	if _, err = c.GetAnswer(); err != nil {
+		t.Fatal(err)
+	}
+	<-gathered
+	if err = remote.SetRemoteDescription(*pc.LocalDescription()); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-connected:
+	case <-time.After(3 * time.Second):
+		t.Fatal("connect timeout")
+	}
+	writePacket := func(i uint16) {
+		payload := append(append([]byte(nil), nal...), byte(i>>8), byte(i))
+		input.WriteRTP(&rtp.Packet{Header: rtp.Header{Version: 2, Marker: true, SequenceNumber: i, Timestamp: uint32(i) * 3000}, Payload: payload})
+	}
+	for i := uint16(1); i <= total; i++ {
+		writePacket(i)
+	}
+	// Continue ordinary media after feedback, as a running source does. Pion
+	// polls its bounded repair queue between primary reads; do not enlarge it.
+	stop := make(chan struct{})
+	var continuing sync.WaitGroup
+	continuing.Add(1)
+	go func() {
+		defer continuing.Done()
+		for i := total + 1; i <= total+100; i++ {
+			select {
+			case <-stop:
+				return
+			case <-time.After(5 * time.Millisecond):
+				writePacket(i)
+			}
+		}
+	}()
+	defer func() { close(stop); continuing.Wait() }()
+
+	select {
+	case got := <-result:
+		loss.mu.Lock()
+		dropped, rtx, resent, lostRepair := len(loss.dropped), loss.rtx, loss.resent, loss.rtxDropped
+		loss.mu.Unlock()
+		if dropped != int(missingCount) {
+			t.Fatalf("drop count=%d", dropped)
+		}
+		if recovered {
+			if got.err != nil {
+				t.Fatalf("late burst unrecovered: unique=%d want=%d err=%v feedback=%d rtx=%d", len(got.found), total, got.err, c.nativeFeedbackPackets.Load(), rtx)
+			}
+			if offerRTX {
+				if rtx <= int(missingCount) || !lostRepair {
+					t.Fatalf("RTX packets=%d lost-first-repair=%v", rtx, lostRepair)
+				}
+			} else if rtx != 0 || resent < int(missingCount) {
+				t.Fatalf("early same-SSRC recovery: RTX=%d resends=%d", rtx, resent)
+			}
+		} else {
+			var timeout net.Error
+			if !errors.As(got.err, &timeout) || !timeout.Timeout() {
+				t.Fatalf("expected bounded timeout, got %v", got.err)
+			}
+			last := uint16(0)
+			for seq := range got.found {
+				if seq > last {
+					last = seq
+				}
+			}
+			if len(got.found) != int(last)-int(missingCount) {
+				t.Fatalf("unexpected recovery/extra loss: unique=%d last=%d", len(got.found), last)
+			}
+			if offerRTX && rtx != 0 {
+				t.Fatalf("expired cache produced %d RTX packets", rtx)
+			}
+			if !offerRTX && resent < int(missingCount) {
+				t.Fatalf("same-SSRC repairs=%d want>=%d", resent, missingCount)
+			}
+		}
+		for seq, payload := range got.found {
+			expected := append(append([]byte(nil), nal...), byte(seq>>8), byte(seq))
+			if !bytes.Equal(payload, expected) {
+				t.Fatalf("payload changed seq=%d: %x != %x", seq, payload, expected)
+			}
+		}
+		if c.nativeFeedbackPackets.Load() == 0 {
+			t.Fatal("NACK not read by native sender")
+		}
+	case <-time.After(4 * time.Second):
+		t.Fatal("receiver timeout")
+	}
+}
+
+type nativeBurstLossConn struct {
+	net.PacketConn
+	mu           sync.Mutex
+	dropped      map[uint16]bool
+	rtx          int
+	resent       int
+	last         uint16
+	dropFirstRTX bool
+	rtxDropped   bool
+}
+
+func (c *nativeBurstLossConn) ReadFrom(b []byte) (int, net.Addr, error) {
+	for {
+		n, addr, err := c.PacketConn.ReadFrom(b)
+		if err != nil {
+			return n, addr, err
+		}
+		if n >= 12 && b[0]>>6 == 2 {
+			pt := b[1] & 0x7f
+			seq := binary.BigEndian.Uint16(b[2:4])
+			c.mu.Lock()
+			drop := false
+			if pt == 96 && seq >= 2 && seq <= c.last {
+				if !c.dropped[seq] {
+					c.dropped[seq] = true
+					drop = true
+				} else {
+					c.resent++
+				}
+			}
+			if pt == 97 {
+				c.rtx++
+				if c.dropFirstRTX && !c.rtxDropped {
+					c.rtxDropped = true
+					drop = true
+				}
+			}
+			c.mu.Unlock()
+			if drop {
+				continue
+			}
+		}
+		return n, addr, nil
+	}
+}
diff --git a/pkg/webrtc/native_report.go b/pkg/webrtc/native_report.go
new file mode 100644
index 0000000..670b5e9
--- /dev/null
+++ b/pkg/webrtc/native_report.go
@@ -0,0 +1,105 @@
+package webrtc
+
+import (
+	"errors"
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/pion/interceptor"
+	"github.com/pion/rtcp"
+	"sync"
+)
+
+var nativeReportBindings sync.Map
+
+type nativeReportBinding struct {
+	mu       sync.Mutex
+	clock    *core.SourceClock
+	rate     uint32
+	seen     bool
+	raw      uint32
+	extended uint64
+}
+
+func (b *nativeReportBinding) register(ssrc uint32) error {
+	old, loaded := nativeReportBindings.LoadOrStore(ssrc, b)
+	if loaded && old != b {
+		return errors.New("native SSRC ownership conflict")
+	}
+	return nil
+}
+func (b *nativeReportBinding) observe(raw uint32) error {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.rate == 0 {
+		return errors.New("native clock rate missing")
+	}
+	if !b.seen {
+		origin := b.clock.Position90k.Load()
+		expected := origin/90000*uint64(b.rate) + (origin%90000)*uint64(b.rate)/90000
+		candidate := (expected & ^uint64(0xffffffff)) | uint64(raw)
+		if candidate+(1<<31) < expected {
+			candidate += 1 << 32
+		}
+		if candidate > expected+(1<<31) && candidate >= 1<<32 {
+			candidate -= 1 << 32
+		}
+		distance := int64(candidate) - int64(expected)
+		if distance < -int64(b.rate)*10 || distance > int64(b.rate)*10 {
+			return errors.New("native clock epoch mismatch")
+		}
+		b.extended = candidate
+		b.seen = true
+	} else {
+		delta := int64(int32(raw - b.raw))
+		if delta < 0 || delta > int64(b.rate)*10 {
+			return errors.New("native RTP clock discontinuity")
+		}
+		b.extended += uint64(delta)
+	}
+	b.raw = raw
+	return nil
+}
+func (b *nativeReportBinding) report(original *rtcp.SenderReport) *rtcp.SenderReport {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if !b.seen {
+		return nil
+	}
+	source := (b.extended/uint64(b.rate))<<32 + ((b.extended%uint64(b.rate))<<32)/uint64(b.rate)
+	// Preserve RTCP's actual sender-report wall time (also used for RTT).
+	// Project every native track from one source-presentation anchor instead
+	// of independently extrapolating each track's last send time.
+	referenceNTP := b.clock.MapPresentation(source)
+	atReport := source + original.NTPTime - referenceNTP
+	clone := *original
+	clone.RTPTime = uint32((atReport>>32)*uint64(b.rate) + ((atReport & 0xffffffff) * uint64(b.rate) >> 32))
+	return &clone
+}
+
+type nativeReportFactory struct{}
+
+func (*nativeReportFactory) NewInterceptor(string) (interceptor.Interceptor, error) {
+	return &nativeReportInterceptor{}, nil
+}
+
+type nativeReportInterceptor struct{ interceptor.NoOp }
+
+func (*nativeReportInterceptor) BindRTCPWriter(writer interceptor.RTCPWriter) interceptor.RTCPWriter {
+	return interceptor.RTCPWriterFunc(func(packets []rtcp.Packet, attributes interceptor.Attributes) (int, error) {
+		out := make([]rtcp.Packet, 0, len(packets))
+		for _, packet := range packets {
+			if sr, ok := packet.(*rtcp.SenderReport); ok {
+				if value, native := nativeReportBindings.Load(sr.SSRC); native {
+					if mapped := value.(*nativeReportBinding).report(sr); mapped != nil {
+						out = append(out, mapped)
+					}
+					continue
+				}
+			}
+			out = append(out, packet)
+		}
+		if len(out) == 0 {
+			return 0, nil
+		}
+		return writer.Write(out, attributes)
+	})
+}
diff --git a/pkg/webrtc/native_report_test.go b/pkg/webrtc/native_report_test.go
new file mode 100644
index 0000000..ec2c62c
--- /dev/null
+++ b/pkg/webrtc/native_report_test.go
@@ -0,0 +1,113 @@
+package webrtc
+
+import (
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/pion/interceptor"
+	"github.com/pion/rtcp"
+	"math"
+	"testing"
+	"time"
+)
+
+func TestNativePresentationReportsShareSourceEpoch(t *testing.T) {
+	for _, origin := range []uint64{900000, 3850409924, (1 << 33) - 9000, (1 << 33) + 9000} {
+		clock := &core.SourceClock{Origin90k: origin}
+		clock.Position90k.Store(origin)
+		video := nativeReportBinding{clock: clock, rate: 90000}
+		audio := nativeReportBinding{clock: clock, rate: 48000}
+		apts := origin + 10011
+		ar := uint32(apts/90000*48000 + (apts%90000)*48000/90000)
+		if err := video.observe(uint32(origin)); err != nil {
+			t.Fatal(err)
+		}
+		if err := audio.observe(ar); err != nil {
+			t.Fatal(err)
+		}
+		now := time.Now()
+		ntp := uint64(now.Unix()+2208988800)<<32 + (uint64(now.Nanosecond())<<32)/1000000000
+		v := video.report(&rtcp.SenderReport{NTPTime: ntp})
+		a := audio.report(&rtcp.SenderReport{NTPTime: ntp})
+		if v.NTPTime != ntp || a.NTPTime != ntp {
+			t.Fatal("RTCP wall time changed")
+		}
+		expected := uint64(origin) * 48000 / 90000
+		lift := func(raw uint32, ref uint64) uint64 {
+			n := (ref &^ uint64(0xffffffff)) | uint64(raw)
+			if n+(1<<31) < ref {
+				n += 1 << 32
+			}
+			if n > ref+(1<<31) {
+				n -= 1 << 32
+			}
+			return n
+		}
+		phase := float64(lift(a.RTPTime, expected))/48000 - float64(lift(v.RTPTime, origin))/90000
+		if math.Abs(phase) > 1.0/48000 {
+			t.Fatalf("origin%d phase%.9f", origin, phase)
+		}
+		later := audio.report(&rtcp.SenderReport{NTPTime: ntp + (1 << 32)})
+		if later.RTPTime-a.RTPTime != 48000 {
+			t.Fatal("presentation clock did not advance by one second")
+		}
+	}
+}
+func TestNativeReportRewritesOnlyOwnedSource(t *testing.T) {
+	clock := &core.SourceClock{Origin90k: 900000}
+	clock.Position90k.Store(900000)
+	binding := &nativeReportBinding{clock: clock, rate: 90000}
+	if err := binding.register(427); err != nil {
+		t.Fatal(err)
+	}
+	defer nativeReportBindings.CompareAndDelete(uint32(427), binding)
+	if (&nativeReportBinding{}).register(427) == nil {
+		t.Fatal("SSRC ownership collision allowed")
+	}
+	if err := binding.observe(900000); err != nil {
+		t.Fatal(err)
+	}
+	original := &rtcp.SenderReport{SSRC: 427, NTPTime: 33, RTPTime: 44, PacketCount: 12, OctetCount: 98}
+	legacy := &rtcp.SenderReport{SSRC: 428, NTPTime: 55, RTPTime: 66}
+	var got []rtcp.Packet
+	writer := (&nativeReportInterceptor{}).BindRTCPWriter(interceptor.RTCPWriterFunc(func(p []rtcp.Packet, _ interceptor.Attributes) (int, error) { got = p; return 0, nil }))
+	if _, err := writer.Write([]rtcp.Packet{original, legacy}, nil); err != nil {
+		t.Fatal(err)
+	}
+	mapped := got[0].(*rtcp.SenderReport)
+	if original.NTPTime != 33 || original.RTPTime != 44 || mapped == original || mapped.NTPTime != original.NTPTime || mapped.PacketCount != 12 || mapped.OctetCount != 98 {
+		t.Fatal("report ownership/counters changed")
+	}
+	if got[1] != legacy {
+		t.Fatal("legacy report changed")
+	}
+	if binding.observe(899999) == nil {
+		t.Fatal("backward source clock allowed")
+	}
+}
+
+func TestNativePresentationDomainOwnership(t *testing.T) {
+	id := "123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0"
+	a, releaseA, err := core.AcquirePresentationDomain(id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, releaseB, err := core.AcquirePresentationDomain(id)
+	if err != nil || a != b {
+		t.Fatal("acquisition domain split")
+	}
+	releaseA()
+	releaseA()
+	c, releaseC, err := core.AcquirePresentationDomain(id)
+	if err != nil || c != b {
+		t.Fatal("live sibling domain removed")
+	}
+	releaseB()
+	releaseC()
+	d, releaseD, err := core.AcquirePresentationDomain(id)
+	if err != nil || d == a {
+		t.Fatal("old generation domain reused")
+	}
+	releaseD()
+	if _, _, err := core.AcquirePresentationDomain("invalid"); err == nil {
+		t.Fatal("invalid owner id accepted")
+	}
+}
diff --git a/pkg/webrtc/native_start.go b/pkg/webrtc/native_start.go
new file mode 100644
index 0000000..a182fe8
--- /dev/null
+++ b/pkg/webrtc/native_start.go
@@ -0,0 +1,88 @@
+package webrtc
+
+import "github.com/AlexxIT/go2rtc/pkg/core"
+
+// DeferStart uses the existing consumer-ready hook only for explicitly declared
+// one-shot sources. It adds no media queue and changes no legacy start policy.
+func (c *Conn) DeferStart(start func()) bool {
+	if c.Mode != core.ModePassiveConsumer || !c.nativeOneShot.Load() {
+		return false
+	}
+	c.nativeStartMu.Lock()
+	defer c.nativeStartMu.Unlock()
+	if c.nativeClosed || c.nativeFailed.Load() {
+		return true // A cancelled consumer must never start a deferred producer.
+	}
+	if c.nativeReady {
+		return false
+	}
+	c.nativeStart = start
+	return true
+}
+
+func (c *Conn) nativeConnected() {
+	c.nativeStartMu.Lock()
+	defer c.nativeStartMu.Unlock()
+	if c.nativeClosed {
+		return
+	}
+	c.nativeReady = true
+	if c.nativeOneShot.Load() && c.pc != nil {
+		c.nativeFeedbackOnce.Do(func() {
+			for _, sender := range c.pc.GetSenders() {
+				c.nativeFeedbackWG.Add(1)
+				go func() {
+					defer c.nativeFeedbackWG.Done()
+					for {
+						packets, _, err := sender.ReadRTCP()
+						if err != nil {
+							return
+						}
+						c.nativeFeedbackPackets.Add(uint64(len(packets)))
+					}
+				}()
+			}
+		})
+	}
+	for _, gate := range c.nativeGates {
+		gate.Signal()
+	}
+	if start := c.nativeStart; start != nil {
+		c.nativeStart = nil
+		// Producer.start launches workers, not a blocking transport read. Holding
+		// this lock linearizes it before a concurrent cancellation.
+		start()
+	}
+}
+
+func (c *Conn) cancelNativeStart() {
+	c.nativeStartMu.Lock()
+	c.nativeClosed = true
+	c.nativeStart = nil
+	c.nativeStartMu.Unlock()
+}
+
+func (c *Conn) nativeQueueOverflow() {
+	if !c.nativeOneShot.Load() || !c.nativeFailed.CompareAndSwap(false, true) {
+		return
+	}
+	c.cancelNativeStart()
+	// Sender invokes OnDrop under its queue lock. Peer teardown can remove that
+	// sender, so do not close the peer synchronously under the same lock.
+	go func() { _ = c.Close() }()
+}
+
+func (c *Conn) nativeGate(gate *core.StartGate) {
+	if gate == nil {
+		return
+	}
+	c.nativeStartMu.Lock()
+	defer c.nativeStartMu.Unlock()
+	if c.nativeClosed {
+		return
+	}
+	c.nativeGates = append(c.nativeGates, gate)
+	if c.nativeReady {
+		gate.Signal()
+	}
+}
diff --git a/pkg/webrtc/native_start_test.go b/pkg/webrtc/native_start_test.go
new file mode 100644
index 0000000..f0084cc
--- /dev/null
+++ b/pkg/webrtc/native_start_test.go
@@ -0,0 +1,104 @@
+package webrtc
+
+import (
+	"encoding/json"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/pion/rtp"
+	"github.com/pion/webrtc/v4"
+	"github.com/stretchr/testify/require"
+)
+
+func TestNativeConsumerDefersOnceUntilConnected(t *testing.T) {
+	c := &Conn{Mode: core.ModePassiveConsumer}
+	c.nativeOneShot.Store(true)
+	called := 0
+	require.True(t, c.DeferStart(func() { called++ }))
+	require.Zero(t, called)
+	c.nativeConnected()
+	c.nativeConnected()
+	require.Equal(t, 1, called)
+	require.False(t, c.DeferStart(func() { called++ }))
+	require.Equal(t, 1, called)
+}
+func TestNativeConsumerCancellationBeforeReadyNeverStarts(t *testing.T) {
+	c := &Conn{Mode: core.ModePassiveConsumer}
+	c.nativeOneShot.Store(true)
+	called := false
+	require.True(t, c.DeferStart(func() { called = true }))
+	c.cancelNativeStart()
+	c.nativeConnected()
+	require.False(t, called)
+	require.True(t, c.DeferStart(func() { called = true }))
+	c.nativeConnected()
+	require.False(t, called)
+}
+func TestNativeConsumerPreservesLegacyAndActiveProducerStart(t *testing.T) {
+	for _, mode := range []core.Mode{core.ModePassiveConsumer, core.ModeActiveProducer, core.ModePassiveProducer} {
+		c := &Conn{Mode: mode}
+		require.False(t, c.DeferStart(func() { t.Fatal("callback must remain caller-owned") }))
+		if mode != core.ModePassiveConsumer {
+			c.nativeOneShot.Store(true)
+			require.False(t, c.DeferStart(nil))
+		}
+	}
+}
+func TestNativeConsumerCancelAndConnectLinearize(t *testing.T) {
+	for range 200 {
+		c := &Conn{Mode: core.ModePassiveConsumer}
+		c.nativeOneShot.Store(true)
+		var calls atomic.Int32
+		require.True(t, c.DeferStart(func() { calls.Add(1) }))
+		var wg sync.WaitGroup
+		wg.Add(2)
+		go func() { defer wg.Done(); c.nativeConnected() }()
+		go func() { defer wg.Done(); c.cancelNativeStart() }()
+		wg.Wait()
+		before := calls.Load()
+		c.nativeConnected()
+		require.LessOrEqual(t, before, int32(1))
+		require.Equal(t, before, calls.Load())
+	}
+}
+func TestNativeOverflowFailsWholePeerWithoutIncreasingQueue(t *testing.T) {
+	pc, err := webrtc.NewPeerConnection(webrtc.Configuration{})
+	require.NoError(t, err)
+	c := NewConn(pc)
+	defer c.Close()
+	c.Mode = core.ModePassiveConsumer
+	c.nativeOneShot.Store(true)
+	var started atomic.Bool
+	require.True(t, c.DeferStart(func() { started.Store(true) }))
+	sender := core.NewSender(&core.Media{Kind: core.KindAudio}, &core.Codec{Name: core.CodecOpus, ClockRate: 48000})
+	sender.OnDrop = c.nativeQueueOverflow
+	for i := range 129 {
+		sender.Input(&rtp.Packet{Header: rtp.Header{Timestamp: uint32(i * 960)}})
+	}
+	require.Equal(t, 128, sender.Packets)
+	require.Equal(t, 1, sender.Drops)
+	require.True(t, c.nativeFailed.Load())
+	c.nativeConnected()
+	require.False(t, started.Load())
+	require.Eventually(t, func() bool { return pc.ConnectionState() == webrtc.PeerConnectionStateClosed }, time.Second, time.Millisecond)
+	require.ErrorContains(t, c.closed.Wait(), "native delivery queue overflow")
+	b, err := json.Marshal(c)
+	require.NoError(t, err)
+	require.Contains(t, string(b), `"native_delivery_failed":true`)
+	sender.Close()
+}
+func TestLegacyOverflowDoesNotFailPeer(t *testing.T) {
+	c := &Conn{Mode: core.ModePassiveConsumer}
+	sender := core.NewSender(&core.Media{Kind: core.KindAudio}, &core.Codec{Name: core.CodecOpus, ClockRate: 48000})
+	sender.OnDrop = c.nativeQueueOverflow
+	for range 129 {
+		sender.Input(&rtp.Packet{})
+	}
+	require.Equal(t, 128, sender.Packets)
+	require.Equal(t, 1, sender.Drops)
+	require.False(t, c.nativeFailed.Load())
+	sender.Close()
+}
diff --git a/pkg/webrtc/rtx_sequence.go b/pkg/webrtc/rtx_sequence.go
new file mode 100644
index 0000000..ef5cce9
--- /dev/null
+++ b/pkg/webrtc/rtx_sequence.go
@@ -0,0 +1,41 @@
+package webrtc
+
+import (
+	"sync"
+
+	"github.com/pion/interceptor"
+	"github.com/pion/rtp"
+)
+
+// Pion's responder caches RTX headers with their sequence number. Allocate the
+// transport sequence at actual transmission instead: every retransmission is
+// a new RTX packet, even when its original media sequence is unchanged.
+// Otherwise a repeated repair may be rejected by SRTP after later RTX traffic
+// advances the receiver's replay window, or after an authenticated repair is
+// discarded by the receiver's bounded application queue.
+type rtxSequenceFactory struct{}
+
+func (*rtxSequenceFactory) NewInterceptor(string) (interceptor.Interceptor, error) {
+	return &rtxSequenceInterceptor{}, nil
+}
+
+type rtxSequenceInterceptor struct{ interceptor.NoOp }
+
+func (*rtxSequenceInterceptor) BindLocalStream(info *interceptor.StreamInfo, writer interceptor.RTPWriter) interceptor.RTPWriter {
+	if info.SSRCRetransmission == 0 {
+		return writer
+	}
+	sequence := rtp.NewRandomSequencer()
+	var mu sync.Mutex
+	return interceptor.RTPWriterFunc(func(header *rtp.Header, payload []byte, attributes interceptor.Attributes) (int, error) {
+		if header.SSRC != info.SSRCRetransmission {
+			return writer.Write(header, payload, attributes)
+		}
+		mu.Lock()
+		defer mu.Unlock()
+		// The cache and concurrent resend owners retain the original header.
+		output := header.Clone()
+		output.SequenceNumber = sequence.NextSequenceNumber()
+		return writer.Write(&output, payload, attributes)
+	})
+}
diff --git a/pkg/webrtc/rtx_sequence_test.go b/pkg/webrtc/rtx_sequence_test.go
