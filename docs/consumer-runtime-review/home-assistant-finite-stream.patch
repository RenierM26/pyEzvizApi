+                return False
+            self.expected_counts = counts
+            self._confirmed = True
+            self._changed.set()
+            return True
+
+    def receive_eof(self, quit_event: Event, timeout: float = 5) -> bool:
+        """Wait within a finite budget for independent completion authorization."""
