+func TestSourceClockWrapAndExplicitEpoch(t *testing.T) {
+	for _, rate := range []uint32{90000, 16000} {
+		// Begin after three complete RTP wraps using an authoritative origin.
+		full := (uint64(3) << 32) + uint64(rate)
+		origin := full * 90000 / uint64(rate)
+		mapping := &sourceClockMapping{origin90k: origin, explicitOrigin: true}
+		sender := sourceClockSender{mapping: mapping, rate: rate}
+		sender.report(&rtp.Packet{Header: rtp.Header{Timestamp: uint32(full)}})
+		if sender.disabled || sender.unwrapped != full {
+			t.Fatalf("epoch not preserved rate=%d: %d", rate, sender.unwrapped)
+		}
+		// A subsequent genuine modulo wrap advances time rather than resetting it.
+		near := (uint64(4) << 32) - 100
+		mapping = &sourceClockMapping{origin90k: near * 90000 / uint64(rate), explicitOrigin: true}
+		sender = sourceClockSender{mapping: mapping, rate: rate}
+		sender.report(&rtp.Packet{Header: rtp.Header{Timestamp: uint32(near)}})
+		sender.report(&rtp.Packet{Header: rtp.Header{Timestamp: 100}})
+		if sender.disabled || sender.unwrapped != (uint64(4)<<32)+100 {
+			t.Fatal("wrap lost", rate, sender.unwrapped)
+		}
+	}
+}
+
+func TestSourceClockDiscontinuityPoisonsAllTracks(t *testing.T) {
