@@ -0,0 +1,162 @@
+package mpegts
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"os/exec"
+	"sync"
+	"testing"
+
+	"github.com/AlexxIT/go2rtc/pkg/aac"
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/pion/rtp"
+)
+
+func TestNativeMuxFullSourcePTS(t *testing.T) {
+	for _, origin := range []uint64{0, 1<<32 + 101, 1<<33 - 101} {
+		t.Run(fmt.Sprint(origin), func(t *testing.T) {
+			m := NewMuxer()
+			pid := m.AddTrack(StreamTypeAAC)
+			codec := aac.ConfigToCodec(aac.EncodeConfig(2, 16000, 1, false))
+			unit := aac.CodecToADTS(codec)
+			unit = append(unit, 0, 0)
+			aac.WriteADTSSize(unit, 9)
+			b := append(m.GetHeader(), m.GetPayload90k(pid, origin, unit)...)
+			d := NewDemuxer()
+			r := bytes.NewReader(b)
+			var actual []SourcePacket
+			for {
+				pkt, err := d.ReadPacket(r)
+				if pkt != nil && pkt.PayloadType != StreamTypeMetadata {
+					actual = append(actual, SourcePacket{pkt, d.SourceTime90k})
+				}
+				if err == io.EOF {
+					break
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			tail, err := d.Flush()
+			tail = append(actual, tail...)
+			if err != nil || len(tail) != 1 || tail[0].Timestamp90k != origin {
+				t.Fatalf("origin=%d tail=%v err=%v", origin, tail, err)
+			}
+		})
+	}
+}
+func TestNativeOpusFinitePESClockAndTail(t *testing.T) {
+	var payload []byte
+	for i := 0; i < 5; i++ {
+		payload = append(payload, 0x7f, 0xe0, 1, 0xf8)
+	}
+	for _, origin := range []uint64{90000, 1<<33 - 1000} {
+		d := NewDemuxer()
+		d.pes = map[uint16]*PES{256: {StreamType: StreamTypePrivateOPUS, PTS: uint32(origin), SourcePTS: origin, TimeKnown: true, Payload: bytes.Clone(payload)}}
+		out, err := d.Flush()
+		if err != nil || len(out) != 5 {
+			t.Fatalf("%v len=%d", err, len(out))
+		}
+		for i, p := range out {
+			if p.Timestamp90k != (origin+uint64(i)*1800)&tsMask {
+				t.Fatalf("packet%d pts%d", i, p.Timestamp90k)
+			}
+		}
+	}
+}
+func TestNativeOpusCancelledBeforeReadiness(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	n := nativeOpus{ctx: ctx, cancel: cancel, gate: core.NewStartGate()}
+	if n.start() != context.Canceled {
+		t.Fatal("cancelled producer started")
+	}
+}
+func TestNativeOpusGeneratedAACClock(t *testing.T) {
+	if _, err := exec.LookPath("ffmpeg"); err != nil {
+		t.Skip("FFmpeg optional local runtime")
+	}
+	input, err := exec.Command("ffmpeg", "-hide_banner", "-loglevel", "error", "-f", "lavfi", "-i", "sine=frequency=440:sample_rate=16000:duration=1", "-c:a", "aac", "-f", "adts", "pipe:1").Output()
+	if err != nil {
+		t.Fatal(err)
+	}
+	codec := aac.ConfigToCodec(aac.EncodeConfig(2, 16000, 1, false))
+	for _, origin := range []uint64{0, 3850409924, (1 << 33) - 5000} {
+		t.Run(fmt.Sprint(origin), func(t *testing.T) {
+			p := &Producer{Connection: core.Connection{Medias: []*core.Media{{Kind: core.KindAudio, Direction: core.DirectionRecvonly, Codecs: []*core.Codec{codec}}}}, Finite: true, OneShot: true, ClockOrigin90k: &origin}
+			if err := p.EnableNativeOpus(); err != nil {
+				t.Fatal(err)
+			}
+			n := p.nativeOpus
+			n.clock = &core.SourceClock{Origin90k: *p.ClockOrigin90k}
+			n.clock.Position90k.Store(*p.ClockOrigin90k)
+			n.track = core.NewReceiver(p.Medias[1], p.Medias[1].Codecs[0])
+			var mu sync.Mutex
+			var stamps []uint32
+			n.track.Input = func(pkt *rtp.Packet) { mu.Lock(); defer mu.Unlock(); stamps = append(stamps, pkt.Timestamp) }
+			n.gate.Signal()
+			if err := n.start(); err != nil {
+				t.Fatal(err)
+			}
+			defer n.close()
+			units := 0
+			for remaining := input; len(remaining) > 0; units++ {
+				size := int(aac.ReadADTSSize(remaining))
+				unit := remaining[:size]
+				remaining = remaining[size:]
+				source := origin + uint64(units)*5760
+				pkt := &rtp.Packet{Header: rtp.Header{PayloadType: StreamTypeAAC, Timestamp: uint32(source)}, Payload: aac.ADTStoRTP(unit)}
+				if err := n.write(pkt, source); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if err := n.finish(); err != nil {
+				t.Fatal(err)
+			}
+			mu.Lock()
+			defer mu.Unlock()
+			if len(stamps) < units*3 {
+				t.Fatalf("short Opus output: %d for %d AAC", len(stamps), units)
+			}
+			expected := uint32((*p.ClockOrigin90k)/90000*48000+((*p.ClockOrigin90k)%90000)*48000/90000) - 120
+			if delta := int32(stamps[0] - expected); delta < -3 || delta > 3 {
+				t.Fatalf("first Opus clock %d expected %d", stamps[0], expected)
+			}
+			for i := 1; i < len(stamps); i++ {
+				if stamps[i]-stamps[i-1] != 960 {
+					t.Fatalf("Opus clock hole %d", i)
+				}
+			}
+		})
+	}
+}
+
+func TestNativeOpusRejectsUndeclaredProfiles(t *testing.T) {
+	good := aac.ConfigToCodec(aac.EncodeConfig(2, 16000, 1, false))
+	origin := uint64(0)
+	for _, name := range []string{"live", "retry", "no-clock", "stereo", "other-rate", "other-ASC"} {
+		t.Run(name, func(t *testing.T) {
+			codec := good.Clone()
+			p := &Producer{Connection: core.Connection{Medias: []*core.Media{{Kind: core.KindAudio, Direction: core.DirectionRecvonly, Codecs: []*core.Codec{codec}}}}, Finite: true, OneShot: true, ClockOrigin90k: &origin}
+			switch name {
+			case "live":
+				p.Finite = false
+			case "retry":
+				p.OneShot = false
+			case "no-clock":
+				p.ClockOrigin90k = nil
+			case "stereo":
+				codec.Channels = 2
+			case "other-rate":
+				codec.ClockRate = 48000
+			case "other-ASC":
+				codec.FmtpLine = "config=140c"
+			}
+			if p.EnableNativeOpus() == nil {
+				t.Fatal("unsupported profile accepted")
+			}
+		})
+	}
+}
