@@ -0,0 +1,38 @@
+package rtsp
+
+import (
+	"bufio"
+	"errors"
+	"fmt"
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/AlexxIT/go2rtc/pkg/tcp"
+	"net"
+	"net/url"
+	"testing"
+)
+
+func TestNativeProfileFrozenResponse(t *testing.T) {
+	for _, row := range []struct {
+		status, header string
+		frozen         bool
+	}{{"409 Conflict", "X-Stream-Native-Error: profile-frozen-v1\r\n", true}, {"409 Conflict", "", false}, {"400 Bad Request", "X-Stream-Native-Error: profile-frozen-v1\r\n", false}} {
+		t.Run(row.status+row.header, func(t *testing.T) {
+			client, server := net.Pipe()
+			defer client.Close()
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				defer server.Close()
+				_, _ = tcp.ReadRequest(bufio.NewReader(server))
+				_, _ = fmt.Fprintf(server, "RTSP/1.0 %s\r\nCSeq: 1\r\n%s\r\n", row.status, row.header)
+			}()
+			c := &Conn{conn: client, reader: bufio.NewReader(client), auth: tcp.NewAuth(nil)}
+			u, _ := url.Parse("rtsp://127.0.0.1/test")
+			_, err := c.Do(&tcp.Request{Method: MethodDescribe, URL: u})
+			if errors.Is(err, core.ErrSourceProfileFrozen) != row.frozen {
+				t.Fatalf("unexpected response mapping: %v", err)
+			}
+			<-done
+		})
+	}
+}
