 }
+
+// GetPayload90k writes an explicit source PTS, including its 33rd wire bit.
+func (m *Muxer) GetPayload90k(pid uint16, source uint64, payload []byte) []byte {
+	if m.sourcePTS == nil {
+		m.sourcePTS = map[uint16]uint64{}
+	}
+	m.sourcePTS[pid] = source
+	return m.GetPayload(pid, uint32(source), payload)
+}
+func writeTime64(b []byte, t uint64) {
+	t &= (uint64(1) << 33) - 1
+	b[0] = 0x20 | byte((t>>30)&7)<<1 | 1
+	b[1] = byte(t >> 22)
+	b[2] = byte(t>>15)<<1 | 1
+	b[3] = byte(t >> 7)
+	b[4] = byte(t)<<1 | 1
+}
