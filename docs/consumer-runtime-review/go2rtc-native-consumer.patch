diff --git a/pkg/core/presentation_clock.go b/pkg/core/presentation_clock.go
new file mode 100644
index 0000000..0e1a80f
--- /dev/null
+++ b/pkg/core/presentation_clock.go
@@ -0,0 +1,64 @@
+package core
+
+import (
+	"encoding/hex"
+	"errors"
+	"sync"
+	"time"
+)
+
+type PresentationClock struct {
+	mu          sync.Mutex
+	set         bool
+	source, ntp uint64
+}
+
+func (c *PresentationClock) Map(source uint64) uint64 {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.set {
+		now := time.Now()
+		c.source = source
+		c.ntp = uint64(now.Unix()+2208988800)<<32 + (uint64(now.Nanosecond())<<32)/1000000000
+		c.set = true
+	}
+	return c.ntp + source - c.source
+}
+
+type presentationLease struct {
+	clock *PresentationClock
+	refs  int
+}
+
+var presentationDomains = map[string]*presentationLease{}
+var presentationMu sync.Mutex
+
+// AcquirePresentationDomain requires an opaque owner-published acquisition id.
+func AcquirePresentationDomain(id string) (*PresentationClock, func(), error) {
+	if len(id) != 64 {
+		return nil, nil, errors.New("invalid native clock domain")
+	}
+	if _, err := hex.DecodeString(id); err != nil {
+		return nil, nil, errors.New("invalid native clock domain")
+	}
+	presentationMu.Lock()
+	lease := presentationDomains[id]
+	if lease == nil {
+		lease = &presentationLease{clock: &PresentationClock{}}
+		presentationDomains[id] = lease
+	}
+	lease.refs++
+	presentationMu.Unlock()
+	var once sync.Once
+	release := func() {
+		once.Do(func() {
+			presentationMu.Lock()
+			defer presentationMu.Unlock()
+			lease.refs--
+			if lease.refs == 0 {
+				delete(presentationDomains, id)
+			}
+		})
+	}
+	return lease.clock, release, nil
+}
