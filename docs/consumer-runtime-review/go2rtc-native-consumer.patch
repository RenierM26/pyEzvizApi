+func TestSourceClockDefersOnlyOptedInStart(t *testing.T) {
+	c := &Conn{}
+	called := false
+	if c.DeferStart(func() { called = true }) {
+		t.Fatal("default changed")
+	}
+	c.sourceClock = &sourceClockMapping{}
+	if !c.DeferStart(func() { called = true }) || called {
+		t.Fatal("started before PLAY")
+	}
+	c.sourceStart()
+	if !called {
+		t.Fatal("start missing")
+	}
+}
+
+func TestSourceClockFailureClosesWithoutBYE(t *testing.T) {
+	left, right := net.Pipe()
+	defer right.Close()
+	conn := NewServer(left)
+	conn.sourceClock = &sourceClockMapping{}
