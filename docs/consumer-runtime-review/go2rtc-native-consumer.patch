@@ -0,0 +1,168 @@
+package mpegts
+
+import (
+	"bytes"
+	"context"
+	"testing"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/aac"
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/pion/rtp"
+)
+
+func fallbackProducer(t *testing.T) *Producer {
+	t.Helper()
+	origin := uint64(90000)
+	codec := aac.ConfigToCodec(aac.EncodeConfig(2, 16000, 1, false))
+	p := &Producer{Connection: core.Connection{Medias: []*core.Media{{Kind: core.KindAudio, Direction: core.DirectionRecvonly, Codecs: []*core.Codec{codec}}}}, Finite: true, OneShot: true, ClockOrigin90k: &origin}
+	if err := p.EnableNativeOpus(); err != nil {
+		t.Fatal(err)
+	}
+	p.nativeOpus.allowHLSFallback = true
+	t.Cleanup(p.nativeOpus.close)
+	return p
+}
+
+func TestNativeHLSFallbackPreservesAACAndVideo(t *testing.T) {
+	p := fallbackProducer(t)
+	video := &core.Media{Kind: core.KindVideo, Direction: core.DirectionRecvonly, Codecs: []*core.Codec{{Name: core.CodecH265, ClockRate: 90000}}}
+	p.Medias = append(p.Medias, video)
+	audioTrack, err := p.GetTrack(p.Medias[0], p.Medias[0].Codecs[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	videoTrack, err := p.GetTrack(video, video.Codecs[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = p.nativeOpus.start(); err != nil {
+		t.Fatal(err)
+	}
+	for _, row := range []struct {
+		track   *core.Receiver
+		typ     byte
+		payload []byte
+	}{
+		{audioTrack, StreamTypeAAC, []byte{1, 2, 3}},
+		{videoTrack, StreamTypeH265, []byte{0, 0, 0, 2, 0x26, 1}},
+	} {
+		calls := 0
+		row.track.Input = func(packet *rtp.Packet) {
+			calls++
+			if !bytes.Equal(packet.Payload, row.payload) {
+				t.Fatal("original codec bytes changed")
+			}
+			origin := *p.ClockOrigin90k
+			expected := uint32(origin/90000*uint64(row.track.Codec.ClockRate) + origin%90000*uint64(row.track.Codec.ClockRate)/90000)
+			if packet.Timestamp != expected {
+				t.Fatalf("source clock changed: %d != %d", packet.Timestamp, expected)
+			}
+		}
+		packet := &rtp.Packet{Header: rtp.Header{PayloadType: row.typ}, Payload: bytes.Clone(row.payload)}
+		if err := p.deliver(packet, 90000); err != nil {
+			t.Fatal(err)
+		}
+		if calls != 1 {
+			t.Fatalf("delivered %d originals", calls)
+		}
+	}
+	if p.nativeOpus.cmd != nil {
+		t.Fatal("HLS-only delivery started an unrequested transcoder")
+	}
+}
+
+func TestNativeHLSFallbackDoesNotHideAdmittedOpusFailure(t *testing.T) {
+	p := fallbackProducer(t)
+	if _, err := p.GetTrack(p.Medias[1], p.Medias[1].Codecs[0]); err != nil {
+		t.Fatal(err)
+	}
+	timer := time.AfterFunc(10*time.Millisecond, p.nativeOpus.cancel)
+	defer timer.Stop()
+	if err := p.nativeOpus.start(); err != context.Canceled {
+		t.Fatalf("got %v", err)
+	}
+	if p.nativeOpus.hlsOnly {
+		t.Fatal("failed admitted joint consumer silently fell back")
+	}
+}
+
+func TestNativeHLSFallbackDoesNotWaitForWebRTC(t *testing.T) {
+	p := fallbackProducer(t)
+	n := p.nativeOpus
+	started := time.Now()
+	if err := n.start(); err != nil {
+		t.Fatal(err)
+	}
+	if time.Since(started) > time.Second {
+		t.Fatal("HLS fallback waited for an unrequested consumer")
+	}
+	if !n.hlsOnly || n.cmd != nil {
+		t.Fatal("fallback launched a converter")
+	}
+	if err := n.finish(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestNativeHLSFallbackRejectsLateOpus(t *testing.T) {
+	p := fallbackProducer(t)
+	if err := p.nativeOpus.start(); err != nil {
+		t.Fatal(err)
+	}
+	count := len(p.Receivers)
+	if _, err := p.GetTrack(p.Medias[1], p.Medias[1].Codecs[0]); err == nil {
+		t.Fatal("late Opus accepted after source start without its prefix")
+	}
+	if len(p.Receivers) != count {
+		t.Fatal("refused late track mutated receiver ownership")
+	}
+}
+
+func TestNativeHLSFallbackCancelledDoesNotStart(t *testing.T) {
+	p := fallbackProducer(t)
+	p.nativeOpus.cancel()
+	if err := p.nativeOpus.start(); err != context.Canceled {
+		t.Fatalf("got %v", err)
+	}
+}
+
+type admissionObservedContext struct {
+	context.Context
+	checked chan struct{}
+}
+
+func (c admissionObservedContext) Err() error {
+	err := c.Context.Err()
+	select {
+	case c.checked <- struct{}{}:
+	default:
+	}
+	return err
+}
+
+func TestNativeHLSFallbackCancellationWhileWaitingForAdmission(t *testing.T) {
+	p := fallbackProducer(t)
+	n := p.nativeOpus
+	checked := make(chan struct{}, 1)
+	n.ctx = admissionObservedContext{Context: n.ctx, checked: checked}
+	n.admission.Lock()
+	result := make(chan error, 1)
+	go func() { result <- n.start() }()
+	select {
+	case <-checked:
+	case <-time.After(time.Second):
+		n.admission.Unlock()
+		t.Fatal("start did not check cancellation")
+	}
+	n.cancel()
+	n.admission.Unlock()
+	select {
+	case err := <-result:
+		if err != context.Canceled {
+			t.Fatalf("cancelled queued source admitted: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("queued source did not exit")
+	}
+}
diff --git a/pkg/mpegts/native_opus.go b/pkg/mpegts/native_opus.go
new file mode 100644
index 0000000..91d38bb
--- /dev/null
+++ b/pkg/mpegts/native_opus.go
@@ -0,0 +1,267 @@
+package mpegts
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"os/exec"
+	"runtime"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/aac"
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/pion/rtp"
+)
+
+// NativeOpusProfile declares joint, finite AV delivery. It is never inferred.
+const NativeOpusProfile = "opus-source-clock-v1"
+
+// NativeOpusHLSFallbackProfile explicitly permits AAC-only delivery when no
+// Opus receiver has been admitted at source start. The original profile is strict.
+const NativeOpusHLSFallbackProfile = "opus-source-clock-hls-fallback-v1"
+
+type nativeOpus struct {
+	admission        sync.Mutex
+	allowHLSFallback bool
+	started          bool
+	hlsOnly          bool
+	domain           *core.PresentationClock
+	releaseDomain    func()
+	codec            *core.Codec
+	gate             *core.StartGate
+	ctx              context.Context
+	cancel           context.CancelFunc
+	cmd              *exec.Cmd
+	input            io.WriteCloser
+	output           io.ReadCloser
+	done             chan error
+	mux              *Muxer
+	pid              uint16
+	once             sync.Once
+	track            *core.Receiver
+	clock            *core.SourceClock
+}
+
+func (c *Producer) EnableNativeOpus() error {
+	if !c.Finite || !c.OneShot || c.ClockOrigin90k == nil {
+		return errors.New("native opus requires finite one-shot source clocks")
+	}
+	var input *core.Codec
+	for _, m := range c.Medias {
+		for _, codec := range m.Codecs {
+			if codec.Name == core.CodecAAC {
+				input = codec
+			}
+		}
+	}
+	if input == nil || input.ClockRate != 16000 || input.Channels != 1 ||
+		!strings.EqualFold(core.Between(input.FmtpLine, "config=", ";"), "1408") {
+		return errors.New("native opus profile requires declared 16k mono AAC")
+	}
+	origin := *c.ClockOrigin90k
+	if origin >= uint64(1)<<33 {
+		return errors.New("native Opus requires a 33-bit source residue")
+	}
+	origin += uint64(1) << 33
+	c.ClockOrigin90k = &origin
+	ctx, cancel := context.WithCancel(context.Background())
+	n := &nativeOpus{codec: input, gate: core.NewStartGate(), ctx: ctx, cancel: cancel, done: make(chan error, 1), mux: NewMuxer()}
+	n.pid = n.mux.AddTrack(StreamTypeAAC)
+	c.nativeOpus = n
+	c.Medias = append(c.Medias, &core.Media{Kind: core.KindAudio, Direction: core.DirectionRecvonly, Codecs: []*core.Codec{{Name: core.CodecOpus, ClockRate: 48000, Channels: 2, PayloadType: core.PayloadTypeRAW}}})
+	return nil
+}
+func (n *nativeOpus) start() error {
+	if err := n.ctx.Err(); err != nil {
+		return err
+	}
+	if n.allowHLSFallback {
+		n.admission.Lock()
+		// Cancellation can arrive while GetTrack owns admission. A queued start
+		// must recheck it before committing an HLS-only plan without a gate wait.
+		if err := n.ctx.Err(); err != nil {
+			n.admission.Unlock()
+			return err
+		}
+		n.started = true
+		n.hlsOnly = n.track == nil
+		hlsOnly := n.hlsOnly
+		n.admission.Unlock()
+		if hlsOnly {
+			return nil
+		}
+	}
+	select {
+	case <-n.gate.Ready:
+	case <-n.ctx.Done():
+		return n.ctx.Err()
+	case <-time.After(core.ProbeTimeout):
+		return errors.New("native AV consumer readiness expired")
+	}
+	if n.track == nil || n.clock == nil {
+		return errors.New("native Opus track not admitted")
+	}
+	n.cmd = exec.CommandContext(n.ctx, "ffmpeg", "-hide_banner", "-loglevel", "error", "-f", "mpegts", "-probesize", "32", "-analyzeduration", "1", "-copyts", "-i", "pipe:0", "-map", "0:a:0", "-c:a", "libopus", "-application", "lowdelay", "-frame_duration", "20", "-ar", "48000", "-ac", "1", "-avoid_negative_ts", "disabled", "-mpegts_copyts", "1", "-muxdelay", "0", "-muxpreload", "0", "-flush_packets", "1", "-f", "mpegts", "pipe:1")
+	var err error
+	if n.input, err = n.cmd.StdinPipe(); err != nil {
+		return err
+	}
+	if n.output, err = n.cmd.StdoutPipe(); err != nil {
+		return err
+	}
+	if err = n.cmd.Start(); err != nil {
+		return err
+	}
+	go func() {
+		err := n.read()
+		if err != nil {
+			n.cancel()
+		}
+		processErr := n.cmd.Wait()
+		if err == nil {
+			err = processErr
+		}
+		n.done <- err
+	}()
+	if deadline, ok := n.input.(interface{ SetWriteDeadline(time.Time) error }); ok {
+		if err = deadline.SetWriteDeadline(time.Now().Add(core.ProbeTimeout)); err != nil {
+			n.cancel()
+			return err
+		}
+	} else {
+		n.cancel()
+		return errors.New("native Opus requires bounded pipe writes")
+	}
+	_, err = n.input.Write(n.mux.GetHeader())
+	return err
+}
+func (n *nativeOpus) write(packet *rtp.Packet, source uint64) error {
+	if n.hlsOnly {
+		return nil // AAC still reaches its original receiver in Producer.deliver.
+	}
+	var failure error
+	if failure = n.input.(interface{ SetWriteDeadline(time.Time) error }).SetWriteDeadline(time.Now().Add(core.ProbeTimeout)); failure != nil {
+		return failure
+	}
+	aac.RTPToADTS(n.codec, func(adts *rtp.Packet) {
+		if failure != nil {
+			return
+		}
+		_, failure = n.input.Write(n.mux.GetPayload90k(n.pid, source, adts.Payload))
+	})(packet)
+	return failure
+}
+func (n *nativeOpus) read() error {
+	d := NewDemuxer()
+	epoch := sourceEpoch{}
+	emit := func(packet *rtp.Packet, raw uint64) error {
+		if packet.PayloadType == StreamTypeMetadata {
+			return nil
+		}
+		if packet.PayloadType != StreamTypePrivateOPUS || len(packet.Payload) == 0 {
+			return errors.New("native opus output invalid")
+		}
+		source, err := epoch.lift(raw, n.clock.Origin90k)
+		if err != nil {
+			return err
+		}
+		packet.Timestamp = uint32(source/90000*48000 + (source%90000)*48000/90000)
+		if n.track != nil {
+			n.track.WriteRTP(packet)
+		}
+		return nil
+	}
+	for {
+		packet, err := d.ReadPacket(n.output)
+		if err == io.EOF {
+			tail, e := d.Flush()
+			if e != nil {
+				return e
+			}
+			for _, p := range tail {
+				if e = emit(p.Packet, p.Timestamp90k); e != nil {
+					return e
+				}
+			}
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		if err = emit(packet, d.SourceTime90k); err != nil {
+			return err
+		}
+	}
+}
+func (n *nativeOpus) finish() error {
+	if n.hlsOnly {
+		return nil
+	}
+	if n.input == nil {
+		return errors.New("native opus was not started")
+	}
+	if err := n.input.Close(); err != nil {
+		n.cancel()
+		return err
+	}
+	select {
+	case err := <-n.done:
+		return err
+	case <-time.After(core.ProbeTimeout):
+		n.cancel()
+		return errors.New("native opus drain expired")
+	}
+}
+
+// EnableNativeOpusHLSFallback selects a separate, negotiated policy. The media
+// plan freezes before the first packet, not after a converter/readiness failure.
+func (c *Producer) EnableNativeOpusHLSFallback() error {
+	if err := c.EnableNativeOpus(); err != nil {
+		return err
+	}
+	c.nativeOpus.allowHLSFallback = true
+	return nil
+}
+func (n *nativeOpus) close() {
+	n.once.Do(func() {
+		n.cancel()
+		if n.releaseDomain != nil {
+			n.releaseDomain()
+		}
+	})
+}
+
+func (c *Producer) SetNativeOpusDomain(id string) error {
+	if c.nativeOpus == nil {
+		return errors.New("native Opus profile absent")
+	}
+	clock, release, err := core.AcquirePresentationDomain(id)
+	if err != nil {
+		return err
+	}
+	c.nativeOpus.domain = clock
+	c.nativeOpus.releaseDomain = release
+	return nil
+}
+
+var nativeOpusAvailability struct {
+	once      sync.Once
+	available bool
+}
+
+// NativeOpusAvailable checks the declared local encoder without opening media.
+func NativeOpusAvailable() bool {
+	nativeOpusAvailability.once.Do(func() {
+		if runtime.GOOS != "linux" {
+			return
+		}
+		ctx, cancel := context.WithTimeout(context.Background(), core.ProbeTimeout)
+		defer cancel()
+		out, err := exec.CommandContext(ctx, "ffmpeg", "-hide_banner", "-encoders").Output()
+		nativeOpusAvailability.available = err == nil && bytes.Contains(out, []byte(" libopus "))
+	})
+	return nativeOpusAvailability.available
+}
