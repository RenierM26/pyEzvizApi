+package mpegts
+
+import (
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"io"
+	"testing"
+)
+
+func TestFiniteFlushOnlyCompletePendingPES(t *testing.T) {
+	d := NewDemuxer()
+	d.pes = map[uint16]*PES{
+		256: {StreamType: StreamTypeH264, PTS: 123, Payload: []byte{0, 0, 0, 1, 0x65, 1, 2}},
+	}
+	packets, err := d.Flush()
+	if err != nil || len(packets) != 1 || packets[0].Packet.Timestamp != 123 {
+		t.Fatal("last video lost", err)
+	}
+	packets, err = d.Flush()
+	if err != nil || len(packets) != 0 {
+		t.Fatal("tail duplicated")
+	}
+}
+
+func TestFiniteFlushIncompletePESFailsBeforeEmission(t *testing.T) {
+	d := NewDemuxer()
+	d.pes = map[uint16]*PES{
+		256: {StreamType: StreamTypeH264, PTS: 123, Payload: []byte{0, 0, 0, 1, 0x65}},
+		257: {StreamType: StreamTypeAAC, PTS: 125, Size: 100, Payload: []byte{1}},
+	}
+	packets, err := d.Flush()
+	if err != io.ErrUnexpectedEOF || len(packets) != 0 || len(d.pes[256].Payload) == 0 {
+		t.Fatal("incomplete tail became success")
+	}
+}
+
+type failedReader struct{ err error }
+
+func (r failedReader) Read(_ []byte) (int, error) { return 0, r.err }
+func TestFiniteTransportFailureIsNotCompletion(t *testing.T) {
+	expected := io.ErrClosedPipe
+	receiver := core.NewReceiver(&core.Media{Kind: core.KindVideo}, &core.Codec{Name: core.CodecH264, ClockRate: 90000})
+	var got error
+	called := false
+	child := &core.Node{OnEnd: func(err error) { called = true; got = err }}
+	child.WithParent(&receiver.Node)
+	producer := &Producer{Connection: core.Connection{Receivers: []*core.Receiver{receiver}}, rd: core.NewReadBuffer(failedReader{expected}), Finite: true}
+	if err := producer.Start(); err != expected || !called || got != expected {
+		t.Fatal("transport failure masked", err, got)
+	}
+}
