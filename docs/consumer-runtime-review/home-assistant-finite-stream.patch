+    """Finite ingest lifetime; completion is not inferred from transport EOF."""
+
+    READY = "ready"
+    ACTIVE = "active"
+    WAITING = "waiting_for_confirmation"
+    FINALIZING = "finalizing"
+    COMPLETED = "completed"
+    FAILED = "failed"
+    CANCELLED = "cancelled"
