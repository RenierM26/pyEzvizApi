+		v := sourceClockSender{mapping: m, rate: 90000}
+		a := sourceClockSender{mapping: m, rate: 16000}
+		v.report(&rtp.Packet{Header: rtp.Header{Timestamp: 90000}})
+		v.report(&rtp.Packet{Header: rtp.Header{Timestamp: next}})
+		a.report(&rtp.Packet{Header: rtp.Header{Timestamp: 16000}})
+		if !m.failed.Load() || !v.disabled || !a.disabled {
+			t.Fatal("discontinuity continued")
+		}
+	}
+}
