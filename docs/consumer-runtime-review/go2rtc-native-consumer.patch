new file mode 100644
index 0000000..660d267
--- /dev/null
+++ b/pkg/mpegts/source_epoch.go
@@ -0,0 +1,39 @@
+package mpegts
+
+import "errors"
+
+const tsMask = uint64(1)<<33 - 1
+
+var errSourceClock = errors.New("source clock discontinuity or ambiguous epoch")
+
+type sourceEpoch struct {
+	started       bool
+	raw, extended uint64
+}
+
+func (s *sourceEpoch) lift(raw, origin uint64) (uint64, error) {
+	if !s.started {
+		v := (origin & ^tsMask) | (raw & tsMask)
+		if v+(uint64(1)<<32) < origin {
+			v += uint64(1) << 33
+		}
+		if v > origin+(uint64(1)<<32) && v >= uint64(1)<<33 {
+			v -= uint64(1) << 33
+		}
+		distance := int64(v) - int64(origin)
+		if distance < -900000 || distance > 900000 {
+			return 0, errSourceClock
+		}
+		s.started = true
+		s.raw = raw
+		s.extended = v
+		return v, nil
+	}
+	delta := (raw - s.raw) & tsMask
+	if delta > 900000 {
+		return 0, errSourceClock
+	}
+	s.raw = raw
+	s.extended += delta
+	return s.extended, nil
+}
