+"""Retain bounded finite AAC startup without changing live stream behavior."""
+
+from collections.abc import Iterator
+from dataclasses import replace
+from types import SimpleNamespace
+from typing import Any
+from unittest.mock import patch
+
+import av
+import pytest
+
+from homeassistant.components.stream import _convert_stream_options, worker
+from homeassistant.components.stream.const import ATTR_SETTINGS, DOMAIN, SOURCE_TIMEOUT
+from homeassistant.core import HomeAssistant
+
+from .test_worker import (
+    AUDIO_STREAM,
+    MockPyAv,
+    PacketSequence,
+    async_decode_stream,
+    mock_stream_settings,  # noqa: F401 -- register the upstream autouse fixture
+)
+
+
+@pytest.mark.parametrize("prefix", [0, 1, 2, 19, 20])
+@pytest.mark.parametrize("finite", [True, False])
+async def test_audio_before_initial_keyframe(
+    hass: HomeAssistant, prefix: int, finite: bool
+) -> None:
+    """Preserve a finite audio prefix; the legacy keyframe search still trims it."""
+    packets = list(PacketSequence(120))
+    audio = list(PacketSequence(prefix))
+    for i, packet in enumerate(audio):
+        packet.stream = AUDIO_STREAM
+        packet.time_base = AUDIO_STREAM.time_base
+        packet.pts = packet.dts = i * 1024
+        packet.duration = 1024
+    py_av = MockPyAv(audio=True)
+    settings = replace(
+        hass.data[DOMAIN][ATTR_SETTINGS], preserve_initial_timestamps=True
+    )
+    original = worker.StreamState.__init__
+
+    def state_init(self: Any, *args: Any, **kwargs: Any) -> None:
+        original(self, *args, **kwargs)
+        if finite:
+            self.finite_source = SimpleNamespace(receive_eof=lambda _: False)
+
+    with patch.object(worker.StreamState, "__init__", state_init):
+        if finite:
+            with pytest.raises(
+                worker.StreamWorkerError, match="completion authorization"
+            ):
+                await async_decode_stream(
+                    hass, audio + packets, py_av=py_av, stream_settings=settings
+                )
+        else:
+            await async_decode_stream(
+                hass, audio + packets, py_av=py_av, stream_settings=settings
+            )
+    assert len(py_av.capture_buffer.audio_packets) == (prefix if finite else 0)
+    assert len(py_av.capture_buffer.video_packets) == 120
+
+
+@pytest.mark.parametrize("bad", ["overflow", "nonkey", "eof"])
+def test_finite_startup_rejects_without_silent_trimming(bad: str) -> None:
+    """Reject overflow, absent keyframes and empty sources without a lossy suffix."""
+    packets = list(PacketSequence(21))
+    for packet in packets:
+        packet.stream = AUDIO_STREAM
+    if bad == "nonkey":
+        packets = list(PacketSequence(2))[1:]
+    if bad == "eof":
+        packets = []
+    expected = StopIteration if bad == "eof" else worker.StreamWorkerError
+    with pytest.raises(expected):
+        worker._finite_first_keyframe(worker.PeekIterator(iter(packets)))
+
+
+def test_declared_finite_aac_does_not_guess_from_video_probe_prefix() -> None:
+    """Select the AAC filter from the declared finite stream, not packet order."""
+
+    class UnreadPackets(Iterator[av.Packet]):
+        def __next__(self) -> av.Packet:
+            raise AssertionError("Finite AAC selection must not consume probe media")
+
+    stream = SimpleNamespace(name="aac")
+    assert (
+        worker.get_audio_bitstream_filter(UnreadPackets(), stream, finite_source=True)
+        == "aac_adtstoasc"
+    )
+
+
+def test_source_clock_rtsp_open_uses_existing_outer_budget(hass: HomeAssistant) -> None:
+    """Use the existing host open budget only for explicit source-clock policy."""
+    options, _ = _convert_stream_options(
+        hass, "rtsp://127.0.0.1/test", {"preserve_initial_timestamps": True}
+    )
+    assert options["stimeout"] == str(SOURCE_TIMEOUT * 1000000)
+    legacy, _ = _convert_stream_options(hass, "rtsp://127.0.0.1/test", {})
+    assert legacy["stimeout"] == "5000000"
