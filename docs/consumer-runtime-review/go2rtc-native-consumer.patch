diff --git a/internal/streams/native_profile_test.go b/internal/streams/native_profile_test.go
new file mode 100644
index 0000000..f9b4342
--- /dev/null
+++ b/internal/streams/native_profile_test.go
@@ -0,0 +1,65 @@
+package streams
+
+import (
+	"errors"
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"testing"
+)
+
+type frozenTestProducer struct {
+	core.Connection
+	frozen      bool
+	gets, stops int
+}
+
+func (p *frozenTestProducer) GetTrack(m *core.Media, c *core.Codec) (*core.Receiver, error) {
+	p.gets++
+	if p.frozen && c.Name == core.CodecOpus {
+		return nil, core.ErrSourceProfileFrozen
+	}
+	return p.Connection.GetTrack(m, c)
+}
+func (p *frozenTestProducer) Start() error { return nil }
+func (p *frozenTestProducer) Stop() error  { p.stops++; return p.Connection.Stop() }
+
+type frozenTestConsumer struct {
+	core.Connection
+	stopped bool
+}
+
+func (c *frozenTestConsumer) AddTrack(m *core.Media, codec *core.Codec, r *core.Receiver) error {
+	s := core.NewSender(m, codec)
+	s.Bind(r)
+	c.Senders = append(c.Senders, s)
+	return nil
+}
+func (c *frozenTestConsumer) Stop() error { c.stopped = true; return c.Connection.Stop() }
+
+func TestNativeProfileFrozenRejectsPartialConsumerWithoutHarmingHLS(t *testing.T) {
+	video := &core.Media{Kind: core.KindVideo, Direction: core.DirectionRecvonly, Codecs: []*core.Codec{{Name: core.CodecH265, ClockRate: 90000}}}
+	audio := &core.Media{Kind: core.KindAudio, Direction: core.DirectionRecvonly, Codecs: []*core.Codec{{Name: core.CodecOpus, ClockRate: 48000}}}
+	source := &frozenTestProducer{Connection: core.Connection{Medias: []*core.Media{video, audio}}, frozen: true}
+	track, _ := source.Connection.GetTrack(video, video.Codecs[0])
+	hls := core.NewSender(video, video.Codecs[0])
+	hls.Bind(track)
+	defer hls.Close()
+	wrapper := &Producer{url: "test:native", conn: source, state: stateStart, receivers: []*core.Receiver{track}}
+	unused := &frozenTestProducer{Connection: core.Connection{Medias: []*core.Media{audio}}}
+	stream := &Stream{producers: []*Producer{wrapper, {url: "test:alternate", conn: unused, state: stateMedias}}}
+	v, a := video.Clone(), audio.Clone()
+	v.Direction = core.DirectionSendonly
+	a.Direction = core.DirectionSendonly
+	consumer := &frozenTestConsumer{Connection: core.Connection{Medias: []*core.Media{v, a}}}
+	if err := stream.AddConsumer(consumer); !errors.Is(err, core.ErrSourceProfileFrozen) {
+		t.Fatalf("partial AV accepted: %v", err)
+	}
+	if !consumer.stopped || len(stream.consumers) != 0 || stream.pending.Load() != 0 {
+		t.Fatal("failed consumer admission leaked")
+	}
+	if source.stops != 0 || wrapper.state != stateStart || len(track.Senders()) == 0 {
+		t.Fatal("healthy HLS sibling was stopped")
+	}
+	if unused.gets != 0 {
+		t.Fatal("frozen profile tried another producer/transcoder")
+	}
+}
diff --git a/internal/streams/owned.go b/internal/streams/owned.go
new file mode 100644
index 0000000..7886266
--- /dev/null
+++ b/internal/streams/owned.go
@@ -0,0 +1,101 @@
+package streams
+
+import (
+	"encoding/hex"
+	"encoding/json"
+	"github.com/AlexxIT/go2rtc/pkg/mpegts"
+	"net/http"
+)
+
+// Private v1 contract: runtime only, no aliases, probes, config writes or source
+// acquisition. Clients generate a fresh 256-bit token before sending the POST,
+// so a lost response can be cleaned up without adopting a foreign registration.
+type ownedStream struct {
+	stream        *Stream
+	token, source string
+}
+
+var ownedStreams = map[string]ownedStream{} // protected by streamsMu
+const ownershipContract = "runtime-token-v1"
+
+func apiOwnedStreams(w http.ResponseWriter, r *http.Request) {
+	w.Header().Set("X-Stream-Ownership", ownershipContract)
+	w.Header().Set("Cache-Control", "no-store")
+	if r.Method == http.MethodGet {
+		// Static, non-acquiring capability negotiation; never exposes leases.
+		w.Header().Set("Content-Type", "application/json")
+		features := []string{"runtime-token-v1", "source-clock-v1", "no-retry-v1"}
+		if mpegts.NativeOpusAvailable() {
+			features = append(features, "native-opus-source-clock-v1", "native-opus-hls-fallback-v1")
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{
+			"contract": ownershipContract,
+			"features": features,
+		})
+		return
+	}
+	name := r.URL.Query().Get("name")
+	token := r.Header.Get("Authorization")
+	const prefix = "Bearer "
+	if len(token) != len(prefix)+64 || token[:len(prefix)] != prefix || name == "" || len(name) > 256 {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	token = token[len(prefix):]
+	if _, err := hex.DecodeString(token); err != nil {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	switch r.Method {
+	case http.MethodPost:
+		// Form body keeps capability URLs out of access-log query strings.
+		r.Body = http.MaxBytesReader(w, r.Body, 8192)
+		if err := r.ParseForm(); err != nil {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		source := r.PostForm.Get("src")
+		if !HasProducer(source) {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		if err := Validate(source); err != nil {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		streamsMu.Lock()
+		defer streamsMu.Unlock()
+		if stream := streams[name]; stream != nil {
+			lease, ok := ownedStreams[name]
+			if ok && lease.stream == stream && lease.token == token && lease.source == source {
+				w.WriteHeader(http.StatusCreated)
+			} else {
+				w.WriteHeader(http.StatusConflict)
+			}
+			return
+		}
+		stream := NewStream(source)
+		streams[name] = stream
+		ownedStreams[name] = ownedStream{stream, token, source}
+		w.WriteHeader(http.StatusCreated)
+	case http.MethodDelete:
+		streamsMu.Lock()
+		defer streamsMu.Unlock()
+		stream := streams[name]
+		if stream == nil {
+			delete(ownedStreams, name)
+			w.WriteHeader(http.StatusNoContent)
+			return
+		}
+		lease, ok := ownedStreams[name]
+		if !ok || lease.stream != stream || lease.token != token {
+			w.WriteHeader(http.StatusConflict)
+			return
+		}
+		delete(streams, name)
+		delete(ownedStreams, name)
+		w.WriteHeader(http.StatusNoContent)
+	default:
+		w.WriteHeader(http.StatusMethodNotAllowed)
+	}
+}
diff --git a/internal/streams/owned_test.go b/internal/streams/owned_test.go
new file mode 100644
index 0000000..1d9f5a0
--- /dev/null
+++ b/internal/streams/owned_test.go
@@ -0,0 +1,111 @@
+package streams
+
+import (
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/stretchr/testify/require"
+)
+
+func TestOwnedRegistration(t *testing.T) {
+	acquisitions := 0
+	HandleFunc("ownedtest", func(string) (core.Producer, error) { acquisitions++; return nil, nil })
+	token := strings.Repeat("a", 64)
+	request := func(method, name, key, source string) int {
+		body := strings.NewReader(url.Values{"src": {source}}.Encode())
+		req := httptest.NewRequest(method, "/api/streams/owned?name="+name, body)
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+		req.Header.Set("Authorization", "Bearer "+key)
+		w := httptest.NewRecorder()
+		apiOwnedStreams(w, req)
+		require.Equal(t, ownershipContract, w.Header().Get("X-Stream-Ownership"))
+		require.NotContains(t, w.Body.String(), key)
+		return w.Code
+	}
+	t.Run("static feature negotiation never acquires", func(t *testing.T) {
+		w := httptest.NewRecorder()
+		apiOwnedStreams(w, httptest.NewRequest("GET", "/api/streams/owned", nil))
+		require.Equal(t, 200, w.Code)
+		require.Equal(t, ownershipContract, w.Header().Get("X-Stream-Ownership"))
+		require.Contains(t, w.Body.String(), "source-clock-v1")
+		require.Contains(t, w.Body.String(), "no-retry-v1")
+		require.NotContains(t, w.Body.String(), token)
+	})
+	t.Run("uncertain create and stale token", func(t *testing.T) {
+		defer Delete("owned-test")
+		require.Equal(t, 201, request("POST", "owned-test", token, "ownedtest:original"))
+		require.Equal(t, 201, request("POST", "owned-test", token, "ownedtest:original"))
+		require.Equal(t, 409, request("DELETE", "owned-test", strings.Repeat("b", 64), ""))
+		require.Equal(t, 204, request("DELETE", "owned-test", token, ""))
+		require.Equal(t, 204, request("DELETE", "owned-test", token, ""))
+	})
+	t.Run("reassign same source revokes token", func(t *testing.T) {
+		defer Delete("owned-test")
+		require.Equal(t, 201, request("POST", "owned-test", token, "ownedtest:original"))
+		_, err := Patch("owned-test", "ownedtest:original")
+		require.NoError(t, err)
+		require.Equal(t, 409, request("DELETE", "owned-test", token, ""))
+		require.NotNil(t, Get("owned-test"))
+	})
+	t.Run("alias mutation revokes original", func(t *testing.T) {
+		defer Delete("owned-test")
+		defer Delete("owned-alias")
+		require.Equal(t, 201, request("POST", "owned-test", token, "ownedtest:original"))
+		_, err := Patch("owned-alias", "owned-test")
+		require.NoError(t, err)
+		_, err = Patch("owned-alias", "ownedtest:replacement")
+		require.NoError(t, err)
+		require.Equal(t, 409, request("DELETE", "owned-test", token, ""))
+		require.Equal(t, []string{"ownedtest:replacement"}, Get("owned-test").Sources())
+	})
+	t.Run("cached connection URL is not ownership", func(t *testing.T) {
+		defer Delete("owned-test")
+		require.Equal(t, 201, request("POST", "owned-test", token, "ownedtest:original"))
+		stream := Get("owned-test")
+		stream.producers[0].conn = &oneShotTestProducer{Connection: core.Connection{URL: "ownedtest:original"}}
+		_, err := Patch("owned-test", "ownedtest:foreign")
+		require.NoError(t, err)
+		cached, err := stream.producers[0].MarshalJSON()
+		require.NoError(t, err)
+		require.Contains(t, string(cached), "ownedtest:original")
+		require.Equal(t, 409, request("DELETE", "owned-test", token, ""))
+		require.Equal(t, []string{"ownedtest:foreign"}, stream.Sources())
+	})
+	t.Run("multi-source replacement survives", func(t *testing.T) {
+		defer Delete("owned-test")
+		require.Equal(t, 201, request("POST", "owned-test", token, "ownedtest:original"))
+		_, err := New("owned-test", "ownedtest:first", "ownedtest:second")
+		require.NoError(t, err)
+		require.Equal(t, 409, request("DELETE", "owned-test", token, ""))
+		require.Len(t, Get("owned-test").Sources(), 2)
+	})
+	t.Run("restart and ABA", func(t *testing.T) {
+		defer Delete("owned-test")
+		require.Equal(t, 201, request("POST", "owned-test", token, "ownedtest:original"))
+		Delete("owned-test") // old process/registration is gone
+		require.Equal(t, 201, request("POST", "owned-test", strings.Repeat("c", 64), "ownedtest:original"))
+		require.Equal(t, 409, request("DELETE", "owned-test", token, ""))
+	})
+	t.Run("concurrent replace cannot be deleted", func(t *testing.T) {
+		for i := 0; i < 100; i++ {
+			Delete("owned-test")
+			require.Equal(t, 201, request("POST", "owned-test", token, "ownedtest:original"))
+			var wg sync.WaitGroup
+			wg.Add(2)
+			go func() { defer wg.Done(); _, err := New("owned-test", "ownedtest:foreign"); require.NoError(t, err) }()
+			go func() {
+				defer wg.Done()
+				code := request("DELETE", "owned-test", token, "")
+				require.Contains(t, []int{204, 409}, code)
+			}()
+			wg.Wait()
+			require.Equal(t, []string{"ownedtest:foreign"}, Get("owned-test").Sources())
+		}
+		Delete("owned-test")
+	})
+	require.Zero(t, acquisitions, "management must never dial a source")
+}
